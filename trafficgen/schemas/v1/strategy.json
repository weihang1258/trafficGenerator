{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trafficgen.local/schemas/v1/strategy.json",
  "title": "Strategy",
  "description": "A strategy is one single-protocol traffic template with its own quantity/rate envelope. mode=synth synthesizes packets from config via a planner; mode=replay replays a pcap asset (protocol is informational, real protocols come from the pcap).",
  "type": "object",
  "required": [
    "name",
    "config"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "title": "Strategy name",
      "description": "Human-readable strategy name.",
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "title": "Strategy mode",
      "description": "synth (default) synthesizes from config; replay replays a pcap asset.",
      "type": "string",
      "enum": [
        "synth",
        "replay"
      ],
      "default": "synth"
    },
    "protocol": {
      "title": "Protocol",
      "description": "Terminal protocol name for synth strategies. Empty when layers infers it; ignored for replay.",
      "type": "string"
    },
    "config": {
      "title": "Strategy config",
      "description": "Synth: flat base fields plus layers array plus protocol sub-maps. Replay: replay spec (pcap_asset_id/speed/direction/checksum_mode).",
      "type": "object",
      "properties": {
        "src_ip": {
          "title": "Source IP",
          "description": "Source IPv4/IPv6 address. Absent = 10.0.0.1 default. Format checked by Go validation (validateConfigNetwork); the pattern rejects empty shapes only.",
          "type": "string",
          "minLength": 1
        },
        "dst_ip": {
          "title": "Destination IP",
          "description": "Destination IPv4/IPv6 address. Absent = 20.0.0.1 default. Format checked by Go validation (validateConfigNetwork).",
          "type": "string",
          "minLength": 1
        },
        "src_mac": {
          "title": "Source MAC",
          "description": "Source MAC XX:XX:XX:XX:XX:XX. Absent = 02:00:00:00:00:01.",
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$"
        },
        "dst_mac": {
          "title": "Destination MAC",
          "description": "Destination MAC XX:XX:XX:XX:XX:XX. Absent = 02:00:00:00:00:02.",
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$"
        },
        "src_port": {
          "title": "Source port",
          "description": "Source port 0-65535. Absent = 12345.",
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "dst_port": {
          "title": "Destination port",
          "description": "Destination port 0-65535. Absent = 80 (DNS overrides to 53).",
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "ttl": {
          "title": "TTL",
          "description": "IP TTL 0-255. Absent = 64.",
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "tos": {
          "title": "TOS byte",
          "description": "Legacy whole-byte TOS 0-255, overrides DSCP/ECN when non-zero.",
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "dscp": {
          "title": "DSCP",
          "description": "DSCP 0-63. Absent = 0x08 (CS1).",
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "ecn": {
          "title": "ECN",
          "description": "ECN 0-3.",
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "ip_flags": {
          "title": "IP flags",
          "description": "IP flags 0-7 (DF=0x02 default). Legacy key flags still accepted.",
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "frag_offset": {
          "title": "Fragment offset",
          "description": "Fragment offset 0-8191 in 8-byte units.",
          "type": "integer",
          "minimum": 0,
          "maximum": 8191
        },
        "vlan_id": {
          "title": "VLAN id",
          "description": "VLAN id 0-4095. Absent = no VLAN tag.",
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "vlan_priority": {
          "title": "VLAN priority",
          "description": "VLAN priority 0-7.",
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "layers": {
          "title": "Layer chain",
          "description": "Ordered layer objects outermost (L2) first, innermost application layer last, e.g. [{\"ip\":{}},{\"tcp\":{}},{\"http\":{}}]. Presence switches validation to layer-chain mode; protocol is inferred from the outermost non-scaffolding layer. Per-layer fields follow the layer registry (flowb_query_layers); unknown fields are rejected by Go validation.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1
          }
        },
        "tcp": {
          "title": "TCP transport options",
          "description": "TCP transport parameters (any TCP-based protocol). mss splits payloads longer than MSS; initial_seq pins the client ISN for reproducible tests.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mss": {
              "title": "TCP MSS",
              "description": "MSS 0-65535, 0 = 1460 default.",
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "window_size": {
              "title": "Window size",
              "description": "Window 0-65535.",
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "initial_seq": {
              "title": "Initial sequence",
              "description": "Client ISN override, 0 = random.",
              "type": "integer",
              "minimum": 0
            },
            "handshake": {
              "title": "Handshake",
              "description": "Emit TCP handshake.",
              "type": "boolean"
            },
            "termination": {
              "title": "Termination",
              "description": "Emit TCP teardown.",
              "type": "boolean"
            },
            "rst": {
              "title": "RST",
              "description": "Abortive RST close instead of FIN.",
              "type": "boolean"
            },
            "retransmit": {
              "title": "Retransmit",
              "description": "Simulate TCP retransmission.",
              "type": "boolean"
            }
          }
        },
        "dns": {
          "title": "DNS options",
          "description": "DNS query/response options.",
          "type": "object",
          "properties": {
            "query_type": {
              "title": "Query type",
              "description": "DNS query type 0-65535.",
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        },
        "icmp": {
          "title": "ICMP options",
          "description": "ICMP type/code/sequence.",
          "type": "object",
          "properties": {
            "type": {
              "title": "ICMP type",
              "description": "ICMP type 0-255.",
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "code": {
              "title": "ICMP code",
              "description": "ICMP code 0-255.",
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "sequence": {
              "title": "ICMP sequence",
              "description": "ICMP sequence 0-65535.",
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        },
        "icmpv6": {
          "title": "ICMPv6 options",
          "description": "ICMPv6 type/code/sequence.",
          "type": "object",
          "properties": {
            "type": {
              "title": "ICMPv6 type",
              "description": "ICMPv6 type 0-255.",
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "code": {
              "title": "ICMPv6 code",
              "description": "ICMPv6 code 0-255.",
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "sequence": {
              "title": "ICMPv6 sequence",
              "description": "ICMPv6 sequence 0-65535.",
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        },
        "arp": {
          "title": "ARP options",
          "description": "ARP operation.",
          "type": "object",
          "properties": {
            "operation": {
              "title": "ARP operation",
              "description": "ARP operation 0-65535.",
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "target_mac": {
              "title": "Target MAC",
              "description": "ARP target hardware address XX:XX:XX:XX:XX:XX. Format checked by Go validation.",
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$"
            },
            "target_ip": {
              "title": "Target IP",
              "description": "ARP target protocol address. Format checked by Go validation.",
              "type": "string",
              "minLength": 1
            }
          }
        },
        "tftp": {
          "title": "TFTP options",
          "description": "TFTP mode and option negotiation.",
          "type": "object",
          "properties": {
            "mode": {
              "title": "TFTP mode",
              "description": "read = download, write = upload.",
              "type": "string",
              "enum": [
                "read",
                "write"
              ]
            },
            "transfer_mode": {
              "title": "Transfer mode",
              "description": "netascii or octet; mail is rejected.",
              "type": "string",
              "enum": [
                "netascii",
                "octet"
              ]
            },
            "error_side": {
              "title": "Error side",
              "description": "Which side sends ERROR.",
              "type": "string",
              "enum": [
                "server",
                "client"
              ]
            },
            "blksize": {
              "title": "Block size",
              "description": "Negotiated block size 8-65464.",
              "type": "integer",
              "minimum": 8,
              "maximum": 65464
            },
            "timeout": {
              "title": "Timeout",
              "description": "Retransmit timeout 1-255 seconds.",
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            },
            "windowsize": {
              "title": "Window size",
              "description": "Sliding window 1-65535.",
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "error_code": {
              "title": "Error code",
              "description": "ERROR code 0-8.",
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "server_tid": {
              "title": "Server TID",
              "description": "Pinned server transfer port; must be >= 1024 and is rejected when flows > 1 in one strategy.",
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            }
          }
        },
        "group_id": {
          "title": "Worker binding",
          "description": "Routes flows with the same generated id to one PacketWorker.",
          "$ref": "defs.json#/$defs/group_id"
        },
        "sub_flows": {
          "title": "Secondary flows",
          "description": "Generic secondary flows bound to the primary (FTP data channel, SIP RTP, SCTP multi-homing).",
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "file_source": {
          "title": "File source",
          "description": "Payload bytes from file/literal/fill/random instead of inline payload.",
          "type": "object"
        },
        "pcap_asset_id": {
          "title": "Pcap asset id",
          "description": "Replay only: previously imported pcap asset to replay.",
          "type": "string",
          "minLength": 1
        },
        "speed": {
          "title": "Replay speed",
          "description": "Replay only: original pace, multiplier of original, or capped bits per second.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "title": "Speed mode",
              "description": "original, multiplier, or bps.",
              "type": "string",
              "enum": [
                "original",
                "multiplier",
                "bps"
              ]
            },
            "multiplier": {
              "title": "Speed multiplier",
              "description": "Must be > 0 in multiplier mode.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "bps": {
              "title": "Speed cap",
              "description": "Bits-per-second cap in bps mode, e.g. 1000 or 1g.",
              "type": "string",
              "minLength": 1
            }
          }
        },
        "direction": {
          "title": "Replay direction",
          "description": "Replay only: single or dual interface. Absent/null/empty = engine default single; other values validated by ValidateReplaySpec.",
          "type": [
            "string",
            "null"
          ]
        },
        "checksum_mode": {
          "title": "Checksum mode",
          "description": "Replay only: recompute or preserve checksums. Absent/null/empty = engine default recompute; other values validated by ValidateReplaySpec.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "speed": {
                "properties": {
                  "mode": {
                    "const": "multiplier"
                  }
                },
                "required": [
                  "mode"
                ]
              }
            },
            "required": [
              "speed"
            ]
          },
          "then": {
            "properties": {
              "speed": {
                "required": [
                  "multiplier"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "speed": {
                "properties": {
                  "mode": {
                    "const": "bps"
                  }
                },
                "required": [
                  "mode"
                ]
              }
            },
            "required": [
              "speed"
            ]
          },
          "then": {
            "properties": {
              "speed": {
                "required": [
                  "bps"
                ]
              }
            }
          }
        }
      ]
    },
    "flow_control": {
      "title": "Strategy flow control",
      "description": "This template's own envelope. Absent on synth = flows/1. Replay only accepts time.",
      "$ref": "defs.json#/$defs/flow_control"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "replay"
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "required": [
              "pcap_asset_id"
            ],
            "not": {
              "required": [
                "layers"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "replay"
          },
          "flow_control": {
            "type": "object"
          }
        },
        "required": [
          "mode",
          "flow_control"
        ]
      },
      "then": {
        "properties": {
          "flow_control": {
            "properties": {
              "type": {
                "const": "time"
              }
            }
          }
        }
      }
    }
  ]
}
