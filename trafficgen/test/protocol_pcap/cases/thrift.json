  {
    "id": "thrift_containers",
    "proto": "thrift",
    "summary": "S4/T-THRIFT-S4-01：LIST/SET/MAP 容器，9 包",
    "spec_json": {
      "layers": [
        {
          "tcp": {}
        },
        {
          "thrift": {}
        }
      ],
      "src_ip": "10.0.0.1",
      "dst_ip": "20.0.0.1",
      "src_port": 12345,
      "dst_port": 9090,
      "count": 1,
      "thrift": {
        "messages": [
          {
            "type": "CALL",
            "method": "describe",
            "seqid": 1,
            "args": [
              {
                "id": 1,
                "type": "LIST",
                "elem_type": "I16",
                "values": [
                  1,
                  -2
                ]
              },
              {
                "id": 2,
                "type": "MAP",
                "key_type": "STRING",
                "value_type": "I32",
                "entries": [
                  {
                    "key": "a",
                    "value": 7
                  }
                ]
              },
              {
                "id": 3,
                "type": "SET",
                "elem_type": "STRING",
                "values": [
                  "x",
                  "y"
                ]
              }
            ]
          }
        ]
      }
    },
    "expect": {
      "packet_count": 9,
      "has_handshake": true,
      "negotiated": true,
      "terminates": true,
      "has_payload": true,
      "fields": [
        {
          "packet": 4,
          "field": "tcp.dstport",
          "value": "9090"
        },
        {
          "packet": 4,
          "field": "tcp.len",
          "value": "69"
        }
      ],
      "frames": [
        {
          "packet": 4,
          "offset": 54,
          "hex": "80 01 00 01 00 00 00 08 64 65 73 63 72 69 62 65 00 00 00 01 0f 00 01 06 00 00 00 02 00 01 ff fe 0d 00 02 0b 08 00 00 00 01 00 00 00 01 61 00 00 00 07 0e 00 03 0b 00 00 00 02 00 00 00 01 78 00 00 00 01 79 00"
        }
      ]
    },
    "notes": [
      "LIST elem type+i32 count；MAP key/value type+i32 count；SET elem type+i32 count；count 为有符号大端 i32。"
    ]
  },
