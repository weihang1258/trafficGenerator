  {
    "id": "thrift_neg_truncated",
    "proto": "thrift",
    "summary": "N1/T-THRIFT-N1：截断 payload 拒绝",
    "spec_json": {
      "layers": [
        {
          "tcp": {}
        },
        {
          "thrift": {}
        }
      ],
      "src_ip": "10.0.0.1",
      "dst_ip": "20.0.0.1",
      "src_port": 12345,
      "dst_port": 9090,
      "count": 1,
      "thrift": {
        "messages": [
          {
            "type": "CALL",
            "method": "echo",
            "seqid": 1,
            "args": [
              {
                "id": 1,
                "type": "STRING",
                "value": "x"
              }
            ]
          }
        ],
        "wire_fault": {
          "kind": "truncate",
          "at": "string_bytes"
        }
      }
    },
    "expect": {
      "expect_error": true,
      "error_contains": "truncated"
    },
    "notes": [
      "长度声明后截断不能静默生成不完整帧。"
    ]
  },
