[
  {
    "id": "thrift_call_reply",
    "proto": "thrift",
    "summary": "S1/T-THRIFT-S1-01：add CALL→REPLY，9 包，大端 i32 与 seqid=1",
    "spec_json": {
      "layers": [
        {
          "tcp": {}
        },
        {
          "thrift": {}
        }
      ],
      "src_ip": "10.0.0.1",
      "dst_ip": "20.0.0.1",
      "src_port": 12345,
      "dst_port": 9090,
      "count": 1,
      "thrift": {
        "messages": [
          {
            "type": "CALL",
            "method": "add",
            "seqid": 1,
            "args": [
              {
                "id": 1,
                "type": "I32",
                "value": 1
              },
              {
                "id": 2,
                "type": "I32",
                "value": 2
              }
            ]
          },
          {
            "type": "REPLY",
            "method": "add",
            "seqid": 1,
            "result": [
              {
                "id": 0,
                "type": "I32",
                "value": 3
              }
            ]
          }
        ]
      }
    },
    "expect": {
      "packet_count": 9,
      "has_handshake": true,
      "negotiated": true,
      "terminates": true,
      "has_payload": true,
      "fields": [
        {
          "packet": 4,
          "field": "tcp.dstport",
          "value": "9090"
        },
        {
          "packet": 4,
          "field": "tcp.len",
          "value": "30"
        },
        {
          "packet": 5,
          "field": "tcp.len",
          "value": "23"
        }
      ],
      "frames": [
        {
          "packet": 4,
          "offset": 54,
          "hex": "80 01 00 01 00 00 00 03 61 64 64 00 00 00 01 08 00 01 00 00 00 01 08 00 02 00 00 00 02 00"
        },
        {
          "packet": 5,
          "offset": 54,
          "hex": "80 01 00 02 00 00 00 03 61 64 64 00 00 00 01 08 00 00 00 00 00 03 00"
        }
      ]
    },
    "notes": [
      "3 握手 + request + response + 4 挥手；偏移=14+20+20。"
    ]
  },
  {
    "id": "thrift_exception_reply",
    "proto": "thrift",
    "summary": "S2/T-THRIFT-S2-01：divide CALL→EXCEPTION，9 包",
    "spec_json": {
      "layers": [
        {
          "tcp": {}
        },
        {
          "thrift": {}
        }
      ],
      "src_ip": "10.0.0.1",
      "dst_ip": "20.0.0.1",
      "src_port": 12345,
      "dst_port": 9090,
      "count": 1,
      "thrift": {
        "messages": [
          {
            "type": "CALL",
            "method": "divide",
            "seqid": 7,
            "args": [
              {
                "id": 1,
                "type": "I32",
                "value": 1
              },
              {
                "id": 2,
                "type": "I32",
                "value": 0
              }
            ]
          },
          {
            "type": "EXCEPTION",
            "method": "divide",
            "seqid": 7,
            "exception": {
              "message": "division by zero",
              "type": 6
            }
          }
        ]
      }
    },
    "expect": {
      "packet_count": 9,
      "has_handshake": true,
      "negotiated": true,
      "terminates": true,
      "has_payload": true,
      "fields": [
        {
          "packet": 4,
          "field": "tcp.dstport",
          "value": "9090"
        },
        {
          "packet": 4,
          "field": "tcp.len",
          "value": "33"
        },
        {
          "packet": 5,
          "field": "tcp.len",
          "value": "49"
        }
      ],
      "frames": [
        {
          "packet": 4,
          "offset": 54,
          "hex": "80 01 00 03 00 00 00 06 64 69 76 69 64 65 00 00 00 07"
        },
        {
          "packet": 5,
          "offset": 54,
          "hex": "80 01 00 03 00 00 00 06 64 69 76 69 64 65 00 00 00 07 0b 00 01 00 00 00 10"
        }
      ]
    },
    "notes": [
      "EXCEPTION type=3；异常 struct 字段 id=1 STRING、id=2 I32。"
    ]
  },
