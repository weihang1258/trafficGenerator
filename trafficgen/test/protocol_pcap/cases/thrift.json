          "offset": 54,
          "hex": "80 01 00 01 00 00 00 04 70 69 6e 67 00 00 00 01 00"
        }
      ]
    },
    "notes": [
      "strategy_fc flows=2；每会话 seqid/状态隔离。"
    ],
    "strategy_fc": {
      "type": "flows",
      "value": 2
    }
