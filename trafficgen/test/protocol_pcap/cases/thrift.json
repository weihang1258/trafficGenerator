  {
    "id": "thrift_ipv6_echo",
    "proto": "thrift",
    "summary": "S6/T-THRIFT-S6-01：IPv6 TCP 9090 echo CALL→REPLY，偏移74，9包",
    "spec_json": {
      "layers": [
        {
          "tcp": {}
        },
        {
          "thrift": {}
        }
      ],
      "src_ip": "2001:db8::1",
      "dst_ip": "2001:db8::2",
      "src_port": 12345,
      "dst_port": 9090,
      "count": 1,
      "thrift": {
        "messages": [
          {
            "type": "CALL",
            "method": "echo",
            "seqid": 9,
            "args": [
              {
                "id": 1,
                "type": "STRING",
                "value": "hello"
              }
            ]
          },
          {
            "type": "REPLY",
            "method": "echo",
            "seqid": 9,
            "result": [
              {
                "id": 0,
                "type": "STRING",
                "value": "hello"
              }
            ]
          }
        ]
      }
    },
    "expect": {
      "packet_count": 9,
      "has_handshake": true,
      "negotiated": true,
      "terminates": true,
      "has_payload": true,
      "fields": [
        {
          "packet": 4,
          "field": "ipv6.src",
          "value": "2001:db8::1"
        },
        {
          "packet": 4,
          "field": "ipv6.dst",
          "value": "2001:db8::2"
        },
        {
          "packet": 4,
          "field": "tcp.dstport",
          "value": "9090"
        }
      ],
      "frames": [
        {
          "packet": 4,
          "offset": 74,
          "hex": "80 01 00 01 00 00 00 04 65 63 68 6f 00 00 00 09 0b 00 01 00 00 00 05 68 65 6c 6c 6f 00"
        }
      ]
    },
    "notes": [
      "IPv6 头40B，数据起点=14+40+20=74。"
    ]
  },
  {
    "id": "thrift_multi_sessions",
