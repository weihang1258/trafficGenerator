[
  {
    "id": "http_flv_get_header",
    "proto": "http_flv",
    "summary": "IPv4/TCP GET request with URI, Host, HTTP/1.1",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "192.0.2.10",
            "dst": "198.51.100.20"
          }
        },
        {
          "http": {
            "method": "GET",
            "uri": "/live/test.flv",
            "version": "HTTP/1.1"
          }
        },
        {
          "http_flv": {}
        }
      ]
    },
    "expect": {
      "packet_count": 9,
      "directional": true,
      "fields": [
        {
          "packet": 4,
          "field": "tcp.dstport",
          "value": "80"
        },
        {
          "packet": 4,
          "field": "http.request.method",
          "value": "GET"
        },
        {
          "packet": 4,
          "field": "http.request.uri",
          "value": "/live/test.flv"
        }
      ],
      "frames": [
        {
          "packet": 4,
          "offset": 54,
          "hex": "47  4 5  54  2 0  2f  6 c  69  7 6  65  2 f  74  6 5  73  7 4  2e  6 6  6c  7 6  20  4 8  54  5 4  50  2 f  31  2 e  31  0 d  0a  4 8  6f  7 3  74  3 a  20  3 1  39  3 8  2e  3 5  31  2 e  31  3 0  30  2 e  32  3 0  0d  0 a  43  6 f  6e  6 e  65  6 3  74  6 9"
        }
      ]
    },
    "notes": [
      "层链改造：扁平四元组并入 ip/tcp 层，顶层 http_flv 子映射迁入 layers[].http_flv",
      "先跑后钉：钉帧按实际 pcap 字节复钉（HTTP 头字节与文档期预测漂移，语义=包5载体帧）"
    ]
  },
