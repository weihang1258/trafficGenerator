 {
  "id": "opcua_subscribe",
  "proto": "opcua",
  "summary": "Create a subscription, monitor one node, publish one notification, then one keep-alive",
  "spec_json": {
   "layers": [
    {
     "tcp": {
      "dst_port": 4840,
      "initial_seq": 700000
     }
    },
    {
     "opcua": {
      "security_mode": "none",
      "subscription": {
       "publishing_interval_ms": 1000,
       "publish_count": 2,
       "publish_interval_ms": 1000,
       "keep_alive": true,
       "max_keep_alive_count": 100,
       "monitored_nodes": [
        "ns=0;i=1001"
       ]
      },
      "close": true
     }
    }
   ]
  },
  "expect": {
   "packet_count": 23,
   "terminates": true,
   "frames": [
    {
     "packet": 8,
     "offset": 54,
     "hex": "4d534746"
    },
    {
     "packet": 10,
     "offset": 54,
     "hex": "4d534746"
    },
    {
     "packet": 12,
     "offset": 54,
     "hex": "4d534746"
    },
    {
     "packet": 14,
     "offset": 54,
     "hex": "4d534746"
    },
    {
     "packet": 16,
     "offset": 54,
     "hex": "4d534746"
    },
    {
     "packet": 18,
     "offset": 54,
     "hex": "434c4f46"
    }
   ],
   "notes": [
    "The five request/response pairs are CreateSubscription, CreateMonitoredItems, SetPublishingMode, Publish with a notification, and Publish keep-alive. CLO is one symmetric message and has no CLO response."
   ]
  }
 },
 {
  "id": "opcua_bad_node",
  "proto": "opcua",
  "summary": "Read an unknown node and return BadNodeIdUnknown 0x80340000",
  "spec_json": {
   "layers": [
    {
     "tcp": {
      "dst_port": 4840,
      "initial_seq": 900000
     }
    },
    {
     "opcua": {
      "security_mode": "none",
      "read": [
       {
        "node_ids": [
         "ns=0;i=9999"
        ],
        "attribute_id": 13
       }
      ],
      "error_inject": {
       "op": "bad_node",
       "node": "ns=0;i=9999"
      },
      "close": true
     }
    }
   ]
  },
  "expect": {
   "packet_count": 15,
   "terminates": true,
   "frames": [
    {
     "packet": 8,
     "offset": 54,
     "hex": "4d534746"
    },
    {
     "packet": 9,
     "offset": 54,
     "hex": "4d534746"
    },
    {
     "packet": 10,
     "offset": 54,
     "hex": "434c4f46"
    }
   ],
   "notes": [
    "The response ServiceResult must be StatusCode BadNodeIdUnknown (0x80340000), encoded on the wire as 00 00 34 80. Its absolute offset is intentionally not hard-coded because RequestHeader timestamps and arrays are variable-length."
   ]
  }
 },
