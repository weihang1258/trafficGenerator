 {
  "id": "opcua_multi_session",
  "proto": "opcua",
  "summary": "Three logical sessions interleave one Read each on one secure channel",
  "spec_json": {
   "layers": [
    {
     "tcp": {
      "dst_port": 4840,
      "initial_seq": 1200000
     }
    },
    {
     "opcua": {
      "security_mode": "none",
      "sessions": 3,
      "read": [
       {
        "node_ids": [
         "ns=1;i=1001"
        ],
        "attribute_id": 13
       }
      ],
      "close": true
     }
    }
   ]
  },
  "expect": {
   "packet_count": 19,
   "terminates": true,
   "frames": [
    {
     "packet": 8,
     "offset": 54,
     "hex": "4d534746"
    },
    {
     "packet": 10,
     "offset": 54,
     "hex": "4d534746"
    },
    {
     "packet": 12,
     "offset": 54,
     "hex": "4d534746"
    },
    {
     "packet": 14,
     "offset": 54,
     "hex": "434c4f46"
    }
   ],
   "notes": [
    "sessions=3 denotes three logical session contexts on one TCP connection; the three Read request/response pairs are interleaved and each keeps its own AuthenticationToken and RequestHandle space."
   ]
  }
 },
 {
  "id": "opcua_bad_size_neg",
  "proto": "opcua",
  "summary": "Negative: malformed MessageSize and an overlong String length are rejected",
  "spec_json": {
   "layers": [
    {
     "tcp": {
      "dst_port": 4840,
      "initial_seq": 1300000
     }
    },
    {
     "opcua": {
      "security_mode": "none",
      "bad_message_size": true,
      "bad_length": true,
      "close": false
     }
    }
   ]
  },
  "expect": {
   "expect_error": true,
   "error_contains": "MessageSize",
   "notes": [
    "The generator must reject the malformed transport length before treating the overlong String/ByteString length as a valid field. No exact packet count is asserted for this negative case."
   ]
  }
 },
 {
  "id": "opcua_no_channel_neg",
  "proto": "opcua",
  "summary": "Negative: a Read before OpenSecureChannel is rejected",
  "spec_json": {
   "layers": [
    {
     "tcp": {
      "dst_port": 4840,
      "initial_seq": 1400000
     }
    },
    {
     "opcua": {
      "security_mode": "none",
      "skip_channel": true,
      "read": [
       {
        "node_ids": [
         "ns=0;i=1001"
        ],
        "attribute_id": 13
       }
      ],
      "close": false
     }
    }
   ]
  },
  "expect": {
   "expect_error": true,
   "error_contains": "secureChannel",
   "notes": [
    "The semantic error is BadSecureChannelIdInvalid (0x80870000); the case is a validation/generation negative and does not assert a server response packet."
   ]
  }
 }
]