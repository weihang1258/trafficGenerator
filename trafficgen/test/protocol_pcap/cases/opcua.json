[
 {
  "id": "opcua_hello_ack",
  "proto": "opcua",
  "summary": "OPC UA transport handshake: HEL/ACK with an empty EndpointUrl",
  "spec_json": {
   "layers": [
    {
     "tcp": {
      "dst_port": 4840,
      "initial_seq": 100000
     }
    },
    {
     "opcua": {
      "security_mode": "none",
      "close": true
     }
    }
   ]
  },
  "expect": {
   "packet_count": 13,
   "has_handshake": true,
   "terminates": true,
   "fields": [
    {
     "packet": 4,
     "field": "tcp.dstport",
     "value": "4840"
    }
   ],
   "frames": [
    {
     "packet": 4,
     "offset": 54,
     "hex": "48454c46 20000000"
    },
    {
     "packet": 5,
     "offset": 54,
     "hex": "41434b46 1c000000"
    },
    {
     "packet": 6,
     "offset": 54,
     "hex": "4f504e46"
    },
    {
     "packet": 8,
     "offset": 54,
     "hex": "434c4f46"
    }
   ],
   "notes": [
    "HEL contains five UInt32 fields plus an empty EndpointUrl String, so MessageSize is 32; ACK contains only the five UInt32 fields, so MessageSize is 28."
   ]
  }
 },
 {
  "id": "opcua_open_none",
  "proto": "opcua",
  "summary": "OpenSecureChannel with SecurityPolicy None followed by a multi-NodeId Read",
  "spec_json": {
   "layers": [
    {
     "tcp": {
      "dst_port": 4840,
      "initial_seq": 200000
     }
    },
    {
     "opcua": {
      "security_mode": "none",
      "read": [
       {
        "node_ids": [
         "ns=0;i=1001",
         "ns=0;i=1002"
        ],
        "attribute_id": 13
       }
      ],
      "close": true
     }
    }
   ]
  },
  "expect": {
   "packet_count": 15,
   "terminates": true,
   "frames": [
    {
     "packet": 6,
     "offset": 54,
     "hex": "4f504e46"
    },
    {
     "packet": 6,
     "offset": 62,
     "hex": "00000000"
    },
    {
     "packet": 7,
     "offset": 54,
     "hex": "4f504e46"
    },
    {
     "packet": 7,
     "offset": 62,
     "hex": "01000000"
    },
    {
     "packet": 8,
     "offset": 54,
     "hex": "4d534746"
    },
    {
     "packet": 8,
     "offset": 62,
     "hex": "01000000"
    },
    {
     "packet": 8,
     "offset": 66,
     "hex": "e8030000"
    },
    {
     "packet": 10,
     "offset": 54,
     "hex": "434c4f46"
    }
   ],
   "notes": [
    "The two ReadValueId entries are ns=0 FourByte NodeIds 1001 and 1002. TokenId 1000 from the OPN response is reused in the MSG request."
   ]
  }
 },
 {
