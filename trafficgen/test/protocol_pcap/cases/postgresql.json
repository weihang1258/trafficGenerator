            "events": [
              {"kind": "startup", "direction": "c2s", "profile": "startup_v3"},
              {"kind": "auth_request", "direction": "s2c", "profile": "auth_profile_defined", "authtype": 0},
              {"kind": "parameter_status", "direction": "s2c", "profile": "parameter_status_outer"},
              {"kind": "parameter_status", "direction": "s2c", "profile": "parameter_status_outer"},
              {"kind": "parameter_status", "direction": "s2c", "profile": "parameter_status_outer"},
              {"kind": "parameter_status", "direction": "s2c", "profile": "parameter_status_outer"},
              {"kind": "parameter_status", "direction": "s2c", "profile": "parameter_status_outer"},
