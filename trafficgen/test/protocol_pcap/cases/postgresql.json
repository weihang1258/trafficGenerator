          }
        }
      ]
    },
    "expect": {
      "has_handshake": true,
      "negotiated": true,
      "terminates": true,
      "has_payload": true,
      "min_packets": 19,
      "fields": [
        {"packet": 1, "field": "tcp.flags", "value": "0x002"},
