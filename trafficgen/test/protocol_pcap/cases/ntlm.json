  "proto": "ntlm",
  "summary": "多 TCP stream/方向 + segmentation：分段后按 stream 重组 token（offset 相对 NTLMSSP 起点）",
  "spec_json": {
   "layers": [
    {
     "ip": {
      "dst": "198.51.100.60",
      "src": "192.0.2.60"
     }
    },
    {
     "tcp": {
      "dst_port": 445,
      "mss": 536,
      "src_port": 45600
     }
    },
    {
     "ntlm": {
      "sessions": [
       {
        "events": [
         {
          "kind": "negotiate"
         },
         {
          "kind": "challenge"
         },
         {
          "kind": "authenticate"
         },
         {
          "kind": "session_setup_success"
         }
        ],
        "id": "s1",
        "user": "alice"
       },
       {
        "events": [
         {
          "kind": "negotiate"
         },
         {
          "kind": "challenge"
         },
         {
          "kind": "authenticate"
         },
         {
          "kind": "session_setup_success"
         }
        ],
        "id": "s2",
        "user": "bob"
       }
      ]
     }
    }
   ]
  },
  "expect": {
   "fields": [
    {
     "field": "tcp.dstport",
     "packet": 1,
     "value": "445"
    },
    {
     "field": "tcp.len",
     "nonzero": true,
     "packet": 4
    }
   ],
   "frames": [
    {
     "hex": "0000009CFE534D42400001000000000001001F00000000000000000000000000",
     "offset": 54,
     "packet": 4
    }
   ],
   "packet_count": 15
  }
 },
