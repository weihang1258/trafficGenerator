 {
  "id": "ntlm_neg_message_truncated",
  "proto": "ntlm",
  "summary": "通用头/三类消息固定字段截断（wire_fault 注入）",
  "spec_json": {
   "layers": [
    {
     "ip": {
      "dst": "198.51.100.60",
      "src": "192.0.2.60"
     }
    },
    {
     "tcp": {
      "dst_port": 445,
      "src_port": 45600
     }
    },
    {
     "ntlm": {
      "wire_fault": "message_length"
     }
    }
   ]
  },
  "expect": {
   "error_contains": "message",
   "expect_error": true
  }
 },
