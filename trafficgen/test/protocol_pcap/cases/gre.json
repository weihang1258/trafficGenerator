 },
 {
  "id": "gre_neg_dyn_key",
  "proto": "gre",
  "summary": "负例：关字段 key 动态被拒（T-GRE-4）",
  "spec_json": {
   "layers": [
    {
     "ip": {
      "src": "10.0.0.1",
      "dst": "20.0.0.1"
     }
    },
    {
     "gre": {
      "key": {
       "strategy": "list",
       "list": [
        100
       ]
      }
     }
    },
    {
     "ip": {
      "src": "10.0.0.1",
      "dst": "20.0.0.1"
     }
    },
    {
     "udp": {
      "src_port": 12345,
      "dst_port": 80
     }
    },
    {
     "dns": {}
    }
   ]
  },
  "expect": {
   "expect_error": true,
   "error_contains": "does not support dynamic"
  }
 }
]
