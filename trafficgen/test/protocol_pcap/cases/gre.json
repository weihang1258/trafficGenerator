 {
  "id": "gre_inner_ttl",
  "proto": "gre",
  "summary": "内层 TTL 覆盖（T-GRE-12）：内层 ip{ttl:60} 生效，外层仍 64——两个 TTL 独立",
  "spec_json": {
   "layers": [
    {
     "ip": {
      "src": "10.0.0.1",
      "dst": "20.0.0.1"
     }
    },
    {
     "gre": {}
    },
    {
     "ip": {
      "src": "192.168.1.1",
      "dst": "192.168.1.2",
      "ttl": 60
     }
    },
    {
     "udp": {
      "src_port": 12345,
      "dst_port": 80
     }
    },
    {
     "dns": {
      "query_only": true
     }
    }
   ]
  },
  "expect": {
   "min_packets": 1,
   "frames": [
    {
     "packet": 1,
     "offset": 22,
     "hex": "40"
    },
    {
     "packet": 1,
     "offset": 46,
     "hex": "3c"
    }
   ],
   "notes": [
    "T-GRE-12【D-GRE-2 §1 决策 C1】：外层 TTL 字节 offset 22=0x40(64)，内层 TTL 字节 offset 46=0x3c(60)（eth14+外ip20+gre4+内ip8）；tshark 内外两层 ip.ttl 同名，用 frames hex 分别钉死"
   ]
  }
 },
