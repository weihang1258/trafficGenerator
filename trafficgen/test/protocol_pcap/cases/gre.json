[
 {
  "id": "gre_basic_ipv4",
  "proto": "gre",
  "summary": "层链形 [ip,gre,ip,udp,dns]：GRE(无flags,proto 0x0800)封装内层 IPv4/UDP/DNS 查询 -> 1 帧；tshark 自动解 GRE",
  "spec_json": {
   "layers": [
    {
     "ip": {
      "src": "10.0.0.1",
      "dst": "20.0.0.1"
     }
    },
    {
     "gre": {}
    },
    {
     "ip": {
      "src": "10.0.0.1",
      "dst": "20.0.0.1"
     }
    },
    {
     "udp": {
      "src_port": 12345,
      "dst_port": 80
     }
    },
    {
     "dns": {}
    }
   ]
  },
  "expect": {
   "min_packets": 1,
   "fields": [
    {
     "packet": 1,
     "field": "gre.flags_and_version",
     "value": "0x0000"
    },
    {
     "packet": 1,
     "field": "gre.proto",
     "value": "0x0800"
    },
    {
     "packet": 1,
     "field": "udp.dstport",
     "value": "80"
    },
    {
     "packet": 1,
     "field": "udp.srcport",
     "value": "12345"
    }
   ],
   "frames": [
    {
     "packet": 1,
     "offset": 34,
     "hex": "00 00 08 00"
    },
    {
     "packet": 1,
     "offset": 58,
     "hex": "30 39 00 50"
    }
   ],
   "notes": [
    "T-GRE-1【D-GRE-1】：GRE 头 offset 34 (eth14+ip20) flags 0000 protocol 0x0800，内层 UDP 12345->80 在 offset 58 = eth14+outerIP20+GRE4+innerIP20（翻转前口径保持）",
    "内层必须以终结层收尾（裸 [ip,gre,ip,udp] 被 V4 拒 must end with a terminal layer），dns 终结层给内层 UDP 真实载荷（DNS 查询 29B）；整帧 95B 与 legacy flat 66B 不等价（D-GRE-1 范围如实声明），offset 34/58 hex 与 udp 字段保持",
    "gre:{} 空配置走默认 key=0（不置 K 位）/checksum=false/sequence=false"
   ]
  }
 },
 {
  "id": "gre_neg_flat",
  "proto": "gre",
  "summary": "负例：顶层扁平五键判死（T-GRE-2）",
  "spec_json": {
   "layers": [
    {
     "ip": {
      "src": "10.0.0.1",
      "dst": "20.0.0.1"
     }
    },
    {
     "gre": {}
    },
    {
     "ip": {
      "src": "10.0.0.1",
      "dst": "20.0.0.1"
     }
    },
    {
     "udp": {
      "src_port": 12345,
      "dst_port": 80
     }
    },
    {
     "dns": {}
    }
   ],
   "count": 2
  },
  "expect": {
   "expect_error": true,
   "error_contains": "no longer accepts flat config field count"
  }
 },
 {
