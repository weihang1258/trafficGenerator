            "src_port": 12345,
            "dst_port": 5000,
            "fragment_size": 16,
            "chunks": [
              {
                "tsn": 500,
                "data": "yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"
              }
            ]
          }
        }
      ]
    },
    "expect": {
      "has_handshake": false,
      "negotiated": false,
      "terminates": false,
      "packet_count": 14,
      "frames": [
        {
          "packet": 5,
          "offset": 46,
          "hex": "00 02 00 20 00 00 01 f4"
        },
        {
          "packet": 11,
          "offset": 46,
          "hex": "00 01 00 14 00 00 01 fa"
        }
      ],
      "notes": [
        "包数实测钉 14（7+7 分片）；f5 首段 B flag(02) len 32+TSN 500=01f4；f11 末段 E flag(01) len 20+TSN 506=01fa（500+6 连续递增）；中段 flags 00 由 7 段序列承载"
      ]
    }
  },
