   "layers": [
    {
     "udp": {}
    },
    {
     "coap": {}
    }
   ],
   "src_ip": "10.0.0.1",
   "dst_ip": "20.0.0.1",
   "src_port": 56576,
   "dst_port": 5683,
   "coap": {
    "method": "GET",
    "path": [
     "bad"
    ],
    "version": 2,
    "token": "AQI=",
    "message_id": 4108
   }
  },
  "expect": {
   "expect_error": true,
   "error_contains": "version",
   "notes": [
    "Version 必须为 RFC 7252 的 1"
   ]
  }
 },
