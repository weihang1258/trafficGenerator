[
 {
  "id": "probe_explicit_close",
  "proto": "smb",
  "summary": "probe: explicit single close, CLOSE exactly one pair",
  "spec_json": {
   "layers": [
    {
     "ip": {
      "src": "10.0.0.100",
      "dst": "10.0.0.1"
     }
    },
    {
     "tcp": {}
    },
    {
     "smb": {
      "operations": [
       {
        "op_type": "close"
       }
      ]
     }
    }
   ]
  },
  "expect": {
   "packet_count": 25,
   "directional": true,
   "fields": [
    {
     "packet": 4,
     "field": "tcp.dstport",
     "value": "445"
    },
    {
     "packet": 16,
     "field": "smb2.cmd",
     "value": "6"
    },
    {
     "packet": 17,
     "field": "smb2.cmd",
     "value": "6"
    },
    {
     "packet": 17,
     "field": "smb2.flags.response",
     "value": "1"
    },
    {
     "packet": 18,
     "field": "smb2.cmd",
     "value": "4"
    },
    {
     "packet": 20,
     "field": "smb2.cmd",
     "value": "2"
    }
   ],
   "frames": [
    {
     "packet": 16,
     "offset": 122,
     "hex": "18 00 00 00 00 00 00 00"
    },
    {
     "packet": 17,
     "offset": 122,
     "hex": "3c 00 00 00"
    }
   ],
   "notes": [
    "probe: target shape layers[].smb business keys; CLOSE exactly one pair (implicit suppressed)"
   ]
  }
 },
