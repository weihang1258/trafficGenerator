 {
  "id": "probe_multi_flow_dynamic",
  "proto": "smb",
  "summary": "probe: flows=2 with dynamic src_port",
  "spec_json": {
   "layers": [
    {
     "ip": {
      "src": "10.0.0.100",
      "dst": "10.0.0.1"
     }
    },
    {
     "tcp": {
      "src_port": {
       "strategy": "inc",
       "range": [
        40001,
        40002
       ],
       "step": 1
      }
     }
    },
    {
     "smb": {}
    }
   ],
   "group_id": {
    "strategy": "fixed",
    "value": "smb-probe"
   }
  },
  "expect": {
   "packet_count": 58,
   "directional": true,
   "fields": [
    {
     "packet": 1,
     "field": "tcp.srcport",
     "value": "40001"
    },
    {
     "packet": 30,
     "field": "tcp.srcport",
     "value": "40002"
    },
    {
     "packet": 4,
     "field": "tcp.dstport",
     "value": "445"
    }
   ],
   "notes": [
    "probe: flows=2 dynamic src_port; per-flow sessions complete"
   ]
  },
  "strategy_fc": {
   "type": "flows",
   "value": 2
  }
 },
