    {
     "packet": 17,
     "field": "smb2.cmd",
     "value": "6"
    },
    {
     "packet": 17,
     "field": "smb2.nt_status",
     "nonzero": true
    },
    {
     "packet": 18,
     "field": "smb2.cmd",
     "value": "4"
    },
    {
     "packet": 20,
     "field": "smb2.cmd",
     "value": "2"
    }
   ],
   "notes": [
    "probe: CLOSE pair exactly one; CLOSE resp nt_status nonzero; teardown intact"
   ]
  }
 },
