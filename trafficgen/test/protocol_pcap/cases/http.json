[
  {
    "id": "http_get_baseline",
    "proto": "http",
    "summary": "GET 基线：单事务请求/响应，Host 自动、Connection close（T-HTTP-7）",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "192.0.2.10",
            "dst": "198.51.100.20"
          }
        },
        {
          "tcp": {
            "src_port": 40010,
            "dst_port": 80
          }
        },
        {
          "http": {}
        }
      ],
      "http": {
        "method": "GET",
        "uri": "/",
        "version": "HTTP/1.1"
      }
    },
    "expect": {
      "packet_count": 9,
      "has_handshake": true,
      "terminates": true,
      "directional": true,
      "fields": [
        {
          "packet": 4,
          "field": "http.request.method",
          "value": "GET"
        },
        {
          "packet": 4,
          "field": "http.request.uri",
          "value": "/"
        },
        {
          "packet": 4,
          "field": "http.request.version",
          "value": "HTTP/1.1"
        },
        {
          "packet": 4,
          "field": "http.host",
          "value": "198.51.100.20"
        },
        {
          "packet": 8,
          "field": "http.response.code",
          "value": "200"
        }
      ]
    }
  },
  {
