  {
    "id": "mpls_neg_label",
    "proto": "mpls",
    "summary": "T-MPLS-4: label 超 20bit（legacy Validate 真门）",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
