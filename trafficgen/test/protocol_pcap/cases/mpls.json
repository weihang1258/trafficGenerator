  {
    "id": "mpls_frames_multi",
    "proto": "mpls",
    "summary": "T-MPLS-9: frames=3 多帧（IP ID 逐帧+1）",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "mpls": {
            "src_port": 12345,
            "dst_port": 80,
            "labels": [
              {
                "label": 100
              }
            ],
            "frames": 3
          }
        }
      ]
    },
    "expect": {
      "packet_count": 3,
      "fields": [
        {
          "packet": 1,
          "field": "mpls.label",
          "value": "100"
        },
        {
          "packet": 2,
          "field": "mpls.label",
          "value": "100"
        },
        {
          "packet": 3,
          "field": "mpls.label",
          "value": "100"
        },
        {
          "packet": 1,
          "field": "ip.id",
          "value": "0x0001"
        },
        {
          "packet": 2,
          "field": "ip.id",
          "value": "0x0002"
        },
        {
          "packet": 3,
          "field": "ip.id",
          "value": "0x0003"
        }
      ],
      "notes": [
        "frames=模板面每流帧数（planner.go:118-121 缺省 1）；IP ID 逐帧+1（planner.go:160-164）——ip.id 值首跑校准"
      ]
    }
