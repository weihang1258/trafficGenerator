                "label": 1048576
              }
            ]
          }
        }
      ]
    },
    "expect": {
      "expect_error": true,
      "error_contains": "exceeds 20 bits",
      "notes": [
        "planner.go:66 锚词；0x100000=2^20（保留标签 0-15 不测=C 类避开）"
      ]
    }
  },
