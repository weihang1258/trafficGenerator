  {
    "id": "h323_port_dyn",
    "proto": "h323",
    "summary": "T-H323-14: h323.src_port 动态 inc+flows=2（逐流端口池，决策 E1）",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": {
              "strategy": "inc",
              "range": [
                "10.0.1.1",
                "10.0.1.2"
              ],
              "step": 1
            },
            "dst": "20.0.0.1"
          }
        },
        {
          "h323": {
            "src_port": {
              "strategy": "inc",
              "range": [
                30000,
                30001
              ],
              "step": 1
            },
            "dst_port": 1720
          }
        }
      ],
      "group_id": {
        "strategy": "fixed",
        "value": "h323-port-dyn"
      }
    },
    "expect": {
      "packet_count": 32,
      "fields": [
        {
          "packet": 1,
          "field": "tcp.srcport",
          "value": "30000"
        },
        {
          "packet": 16,
          "field": "tcp.srcport",
          "value": "30000"
        },
        {
          "packet": 17,
          "field": "tcp.srcport",
          "value": "30001"
        },
        {
          "packet": 32,
          "field": "tcp.srcport",
          "value": "30001"
        },
        {
          "packet": 1,
          "field": "ip.src",
          "value": "10.0.1.1"
        },
        {
          "packet": 17,
          "field": "ip.src",
          "value": "10.0.1.2"
        }
      ],
      "notes": [
        "逐流成对序（group_id 固定单 worker FIFO，icmpv6 T-11 先例）：流1=包1-16 源口 30000、流2=包17-32 源口 30001；首跑校准"
      ]
    },
    "strategy_fc": {
      "type": "flows",
      "value": 2
    }
