          "field": "tcp.flags",
          "value": "0x012"
        },
        {
          "packet": 3,
          "field": "tcp.flags",
          "value": "0x010"
        },
        {
          "packet": 4,
          "field": "q931.message_type",
          "value": "0x05"
        },
        {
          "packet": 5,
          "field": "q931.message_type",
          "value": "0x02"
        },
        {
          "packet": 6,
          "field": "q931.message_type",
          "value": "0x62"
        },
        {
          "packet": 7,
          "field": "q931.message_type",
          "value": "0x01"
        },
        {
          "packet": 11,
          "field": "q931.message_type",
          "value": "0x07"
        },
        {
          "packet": 12,
          "field": "q931.message_type",
          "value": "0x5a"
