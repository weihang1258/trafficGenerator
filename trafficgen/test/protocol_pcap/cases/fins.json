        "memory_area": "dm",
        "address": 100,
        "items": 1
       }
      ]
     }
    }
   ]
  },
  "expect": {
   "min_packets": 4,
   "fields": [
    {
     "packet": 0,
     "field": "omron.sid",
     "distinct_values": [
      "0x01"
     ]
    },
    {
     "packet": 1,
     "field": "udp.srcport",
     "nonzero": true
    }
