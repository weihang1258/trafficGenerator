        "address": 100,
        "items": 1
       }
      ]
     }
    }
   ]
  },
  "expect": {
   "packet_count": 2,
   "fields": [
    {
     "packet": 1,
     "field": "ipv6.src",
     "value": "2001:db8::1"
    },
    {
     "packet": 1,
     "field": "ipv6.dst",
     "value": "2001:db8::2"
    },
    {
     "packet": 1,
     "field": "udp.dstport",
     "value": "9600"
    },
    {
     "packet": 1,
     "field": "omron.command",
     "value": "0x0101"
    },
    {
     "packet": 1,
     "field": "omron.icf",
     "value": "0x80"
    },
    {
     "packet": 2,
     "field": "ipv6.src",
     "value": "2001:db8::2"
    },
    {
     "packet": 2,
     "field": "omron.response.code",
     "value": "0x0000"
    }
   ],
   "notes": [
    "19-fins-design.md §2.8/§6 S9：FINS/UDP 帧无附加头，载荷与 IP 版本无关",
    "请求/响应 swap src/dst；FrameAssert offset 62（eth14+ip640+udp8）"
   ]
  }
 },
