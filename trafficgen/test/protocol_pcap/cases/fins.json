 {
  "id": "fins_hr_read_bit",
  "proto": "fins",
  "summary": "T-009: HR 位域读（H10 的 bit2/3 读 2 bit），omron.memory.area.read=0x32（HR 位码）、address.bits=0x02、numitems=2，响应数据 2 字节 01 00（FrameAssert 校验位数据每 bit 1 字节）",
  "spec_json": {
   "layers": [
    {
     "ip": {
      "src": "10.0.0.1",
      "dst": "20.0.0.1"
     }
    },
    {
     "udp": {
      "src_port": 1242,
      "dst_port": 9600
     }
    },
    {
     "fins": {
      "transport": "udp",
      "commands": [
       {
        "command": 257,
        "memory_area": "hr",
        "address": 16,
        "bit": 2,
        "items": 2,
        "data": [
         1,
         0
        ]
       }
      ]
     }
    }
   ]
  },
  "expect": {
   "packet_count": 2,
   "fields": [
    {
     "packet": 1,
     "field": "omron.memory.area.read",
     "value": "0x32"
    },
    {
     "packet": 1,
     "field": "omron.memory.address",
     "value": "0x0010"
    },
    {
     "packet": 1,
     "field": "omron.memory.address.bits",
     "value": "0x02"
    },
    {
     "packet": 1,
     "field": "omron.memory.numitems",
     "value": "2"
    },
    {
     "packet": 2,
     "field": "omron.response.code",
     "value": "0x0000"
    }
   ],
   "frames": [
    {
     "packet": 2,
     "offset": 56,
     "hex": "01 00"
    }
   ],
   "notes": [
    "19-fins-design.md §2.3/§3.7：位读响应每 bit 1 字节(0x00/0x01)；HR 位码=0x32",
    "FrameAssert offset 56 = UDP 帧尾 2 字节（42+12头+2命令码+2结束码=58，末2B）",
    "data 配置为读响应的期望位值 [1,0] → bit2=ON、bit3=OFF"
   ]
  }
 },
