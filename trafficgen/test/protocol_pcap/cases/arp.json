 {
  "id": "arp_t3_explicit_addrs",
  "proto": "arp",
  "summary": "T-3 显式地址覆盖：sender/target IP+MAC 全显式 → sha/spa/tha/tpa 与 ether src 双钉",
  "spec_json": {
   "layers": [
    {
     "eth": {
      "src_mac": "aa:bb:cc:dd:ee:01",
      "dst_mac": "aa:bb:cc:dd:ee:02"
     }
    },
    {
     "arp": {
      "sender_mac": "11:22:33:44:55:66",
      "target_mac": "66:55:44:33:22:11",
      "sender_ip": "192.168.10.5",
      "target_ip": "192.168.10.1"
     }
    }
   ]
  },
  "expect": {
   "packet_count": 2,
   "fields": [
    {
     "packet": 1,
     "field": "eth.src",
     "value": "11:22:33:44:55:66"
    }
   ],
   "notes": [
    "ARP 层 sender_mac 覆盖 eth 层推导（层键优先）"
   ],
   "frames": [
    {
     "packet": 1,
     "offset": 22,
     "hex": "11 22 33 44 55 66"
    },
    {
     "packet": 1,
     "offset": 28,
     "hex": "c0 a8 0a 05"
    },
    {
     "packet": 1,
     "offset": 38,
     "hex": "c0 a8 0a 01"
    },
    {
     "packet": 2,
     "offset": 22,
     "hex": "66 55 44 33 22 11"
    },
    {
     "packet": 2,
     "offset": 32,
     "hex": "11 22 33 44 55 66"
    },
    {
     "packet": 2,
     "offset": 38,
     "hex": "c0 a8 0a 05"
    }
   ]
  }
 },
 {
  "id": "arp_t4_single_reply",
  "proto": "arp",
  "summary": "T-4 单发宣告（op=2）：1 帧，ether 单播 dst=sender_mac（裁定3 勘误：legacy 此形广播错位）",
  "spec_json": {
   "layers": [
    {
     "eth": {
      "src_mac": "aa:bb:cc:dd:ee:01",
      "dst_mac": "aa:bb:cc:dd:ee:02"
     }
    },
    {
     "arp": {
      "operation": 2
     }
    }
   ]
  },
  "expect": {
   "packet_count": 1,
   "fields": [
    {
     "packet": 1,
     "field": "eth.dst",
     "value": "aa:bb:cc:dd:ee:01"
    },
    {
     "packet": 1,
     "field": "arp.opcode",
     "value": "2"
    }
   ],
   "notes": [
    "op=2 对端角色：sha=target_mac/spa=target_ip/tha=sender_mac/tpa=sender_ip"
   ],
   "frames": [
    {
     "packet": 1,
     "offset": 20,
     "hex": "00 02"
    },
    {
     "packet": 1,
     "offset": 22,
     "hex": "aa bb cc dd ee 02"
    },
    {
     "packet": 1,
     "offset": 32,
     "hex": "aa bb cc dd ee 01"
    }
   ]
  }
 },
 {
  "id": "arp_t5_neg_operation",
  "proto": "arp",
  "summary": "负例：operation=3 拒（V9 registry [1,2] 先火）",
  "spec_json": {
   "layers": [
    {
     "eth": {
      "src_mac": "aa:bb:cc:dd:ee:01",
      "dst_mac": "aa:bb:cc:dd:ee:02"
     }
    },
    {
     "arp": {
      "operation": 3
     }
    }
   ]
  },
  "expect": {
   "expect_error": true,
   "error_contains": "out of range [1,2]"
  }
 },
 {
  "id": "arp_t6_neg_sender_ip",
  "proto": "arp",
