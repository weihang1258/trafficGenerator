  }
 },
 {
  "id": "arp_t7_neg_ip_carrier",
  "proto": "arp",
  "summary": "负例：[eth,ip,arp] IP 承载混入拒（V-carrier 通用门，sv 同款锚）",
  "spec_json": {
   "layers": [
    {
     "eth": {
      "src_mac": "aa:bb:cc:dd:ee:01",
      "dst_mac": "aa:bb:cc:dd:ee:02"
     }
    },
    {
     "ip": {
      "src": "10.0.0.1",
      "dst": "20.0.0.1"
     }
    },
    {
     "arp": {}
    }
   ]
  },
  "expect": {
   "expect_error": true,
   "error_contains": "must not have an ip/transport carrier"
  }
 },
 {
  "id": "arp_t8_neg_presence",
  "proto": "arp",
  "summary": "负例：层链+顶层 arp 子映射并存=判死（presence 负例形状）",
  "spec_json": {
   "layers": [
    {
     "eth": {
      "src_mac": "aa:bb:cc:dd:ee:01",
      "dst_mac": "aa:bb:cc:dd:ee:02"
     }
    },
    {
     "arp": {}
    }
   ],
   "arp": {}
  },
  "expect": {
   "expect_error": true,
