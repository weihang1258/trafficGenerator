[
 {
  "id": "arp_t1_baseline_pair",
  "proto": "arp",
  "summary": "T-1 基线配对：op=1 缺省地址 2 帧——帧1 广播 ff*6+oper 0001+tha 全零；帧2 单播+oper 0002 角色互换",
  "spec_json": {
   "layers": [
    {
     "eth": {
      "src_mac": "aa:bb:cc:dd:ee:01",
      "dst_mac": "aa:bb:cc:dd:ee:02"
     }
    },
    {
     "arp": {}
    }
   ]
  },
  "expect": {
   "packet_count": 2,
   "fields": [
    {
     "packet": 1,
     "field": "eth.dst",
     "value": "ff:ff:ff:ff:ff:ff"
    },
    {
     "packet": 1,
     "field": "arp.opcode",
     "value": "1"
    },
    {
     "packet": 2,
     "field": "arp.opcode",
     "value": "2"
    },
    {
     "packet": 2,
     "field": "eth.dst",
     "value": "aa:bb:cc:dd:ee:01"
    }
   ],
   "notes": [
    "缺省 sender_ip=10.0.0.1/target_ip=10.0.0.2（裁定2 生成器缺省）；帧序从落盘 pcap 钉（P5）"
   ],
   "frames": [
    {
     "packet": 1,
     "offset": 14,
     "hex": "00 01 08 00 06 04 00 01"
    },
    {
     "packet": 1,
     "offset": 38,
     "hex": "0a 00 00 02"
    },
    {
     "packet": 2,
     "offset": 20,
     "hex": "00 02"
    },
    {
     "packet": 2,
     "offset": 22,
     "hex": "aa bb cc dd ee 02"
    },
    {
     "packet": 2,
     "offset": 32,
     "hex": "aa bb cc dd ee 01"
    },
    {
     "packet": 2,
     "offset": 38,
     "hex": "0a 00 00 01"
    }
   ]
  }
 },
