        {"packet": 11, "field": "xmpp.id", "value": "bind_1"},
        {"packet": 11, "field": "xmpp.type", "value": "result"},
        {"packet": 12, "field": "xmpp.id", "value": "sess_1"},
        {"packet": 12, "field": "xmpp.type", "value": "set"},
