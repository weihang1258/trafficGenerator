[
  {
    "id": "pptp_full_session_ref",
    "proto": "pptp",
    "summary": "T-1 full 会话（smoke 改写，参考 pcap 逐字节）：SCCRQ/SCCRP/OCRQ/OCRP/SLI×5/CCRQ+CCDN 合并/CCDN/StopRQ/StopRP",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "pptp": {}
        }
      ]
    },
    "expect": {
      "has_handshake": true,
      "terminates": true,
      "fields": [
        {
          "packet": 1,
          "field": "tcp.dstport",
          "value": "1723"
        },
        {
          "packet": 4,
          "field": "tcp.len",
          "value": "156"
        },
        {
          "packet": 5,
          "field": "tcp.len",
          "value": "156"
        },
        {
          "packet": 6,
          "field": "tcp.len",
          "value": "168"
        },
        {
          "packet": 7,
          "field": "tcp.len",
          "value": "32"
        },
        {
          "packet": 8,
          "field": "tcp.len",
          "value": "24"
        },
        {
          "packet": 18,
          "field": "tcp.len",
          "value": "16"
        },
        {
          "packet": 19,
          "field": "tcp.len",
          "value": "164"
        },
        {
          "packet": 20,
          "field": "tcp.len",
          "value": "148"
        },
        {
          "packet": 21,
          "field": "tcp.len",
          "value": "16"
        },
        {
          "packet": 22,
          "field": "tcp.len",
          "value": "16"
        }
      ],
      "notes": [
        "26 帧=握手3+SCCRQ 156/SCCRP 156/OCRQ 168/OCRP 32+SLI×5(24B)+GRE 数据×5+CCRQ 16/CCRQ+CCDN 合并 164/CCDN 148/StopRQ 16/StopRP 16+挥手4",
        "包 13-17=GRE 数据面（IP proto 47 无 TCP 端口，data_frames 缺省 5）；参考 pcap quirks 保留（SLI-down peer call id=0xc02a、CCRQ+CCDN 合并段）",
        "1723 由 legacy Plan :404 缺省；恒 1723 断言面=tcp.dstport（包 1 请求帧）"
      ],
      "packet_count": 26
    }
  },
  {
    "id": "pptp_control_header_magic",
    "proto": "pptp",
    "summary": "T-2 控制头钉：magic cookie 1a2b3c4d+Length+Type 字节（TCP 载荷首 8B）",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "pptp": {}
        }
      ]
    },
    "expect": {
      "has_handshake": true,
      "terminates": true,
      "notes": [
        "控制头 12B 实测（RFC 2637 §2）：Length(2B)=0x009c=156、PPTP Message Type(2B)=1（control）、Magic 1a2b3c4d、Control Type 0001=SCCRQ/0002=SCCRP、Reserved(2B)",
        "offset 54=eth14+IP20+TCP20"
      ],
      "packet_count": 26,
      "frames": [
        {
          "packet": 4,
          "offset": 54,
          "hex": "00 9c 00 01 1a 2b 3c 4d 00 01 00 00"
        },
        {
          "packet": 5,
          "offset": 54,
          "hex": "00 9c 00 01 1a 2b 3c 4d 00 02 00 00"
        }
      ]
    }
  },
  {
    "id": "pptp_scenario_control_only",
    "proto": "pptp",
    "summary": "T-3 scenario=control_only：控制面消息子集（无 GRE 数据面）",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "pptp": {
            "scenario": "control_only"
          }
        }
      ]
    },
    "expect": {
      "has_handshake": true,
      "terminates": true,
      "notes": [
        "实测 21 包"
      ],
      "packet_count": 21
    }
  },
  {
    "id": "pptp_scenario_tunnel_only",
    "proto": "pptp",
    "summary": "T-4 scenario=tunnel_only：隧道建立+数据面（无控制拆除）",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "pptp": {
            "scenario": "tunnel_only"
          }
        }
      ]
    },
    "expect": {
      "has_handshake": true,
      "terminates": true,
      "notes": [
        "P2 errata 勘误：tunnel_only=隧道建立+拆除（无数据面——emitDataPlane 仅 full/data_only 触发，planner.go :665/:605）；16 帧=3 握手+控制面 9+挥手 4"
      ],
      "packet_count": 16
    }
  },
  {
    "id": "pptp_scenario_data_only",
    "proto": "pptp",
    "summary": "T-5 scenario=data_only：纯 GRE 数据面",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "pptp": {
            "scenario": "data_only",
            "data_frames": 2
          }
        }
      ]
    },
    "expect": {
      "notes": [
        "data_only=纯 GRE 数据面（无 TCP 握手/挥手——场景语义即跳过控制面），断言面=GRE 帧数"
      ],
      "packet_count": 4
    }
  },
  {
    "id": "pptp_role_pac",
    "proto": "pptp",
    "summary": "T-6 role=pac：PAC 侧换向（方向/Call ID 语义反转）",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "pptp": {
            "role": "pac",
            "scenario": "control_only"
          }
        }
      ]
    },
    "expect": {
      "has_handshake": true,
      "terminates": true,
      "notes": [
        "方向面换向：SCCRQ 由 PAC 发出（语义反转）"
      ],
      "packet_count": 21
    }
  },
  {
    "id": "pptp_calls_two",
    "proto": "pptp",
    "summary": "T-7 calls=2 多 call 并发：OCRQ/OCRP 两轮+SLI 逐 call",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
