          "pptp": {
            "calls": 2,
            "scenario": "control_only"
          }
        }
      ]
    },
    "expect": {
      "has_handshake": true,
      "terminates": true,
      "notes": [
        "实测 31 包；Call ID 递增面"
      ],
      "packet_count": 31
    }
  },
  {
    "id": "pptp_sli_count_three",
    "proto": "pptp",
    "summary": "T-8 sli_count=3：SLI 条数钉（缺省 5 由 T-1 承接）",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "pptp": {
            "sli_count": 3
          }
        }
      ]
    },
    "expect": {
      "min_packets": 20,
      "has_handshake": true,
      "terminates": true,
      "notes": [
        "SLI×3 → 总包数 22-2=20"
      ]
    }
  },
  {
    "id": "pptp_echo_keepalive",
    "proto": "pptp",
    "summary": "T-9 echo=true：ECRQ/ECRP 保活对（RFC 2637 §3.2.9-10）",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "pptp": {
            "echo": true,
            "scenario": "control_only"
          }
        }
      ]
    },
    "expect": {
      "has_handshake": true,
      "terminates": true,
      "notes": [
        "ECRQ(up)/ECRP(down) 一对；msgType 5/6"
      ],
      "packet_count": 23
    }
  },
  {
    "id": "pptp_data_both_directions",
    "proto": "pptp",
    "summary": "T-10 双数据方向：scenario=full+data_frames=2+down_data_frames=1 逐帧 GRE 头（数据面住 full 编排）",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "pptp": {
            "scenario": "full",
            "data_frames": 2,
            "down_data_frames": 1
          }
        }
      ]
    },
    "expect": {
      "notes": [
        "GRE 增强头实测（帧 13=full 场景首个数据帧）：flags 0x3081+proto 0x880B（RFC 2637 §4.1）",
        "24 帧=full 基准 26-缺省 5 数据+3（data_frames 2+down 1）；帧 13-15=GRE 帧（ip.proto 47）"
      ],
      "frames": [
        {
          "packet": 13,
          "offset": 34,
          "hex": "30 81 88 0b"
        }
      ],
      "packet_count": 24
    }
  },
  {
    "id": "pptp_inner_ip_explicit",
    "proto": "pptp",
    "summary": "T-11 inner_ip 显式：src/dst/proto/payload 字节透传（PPP FF 03+0x0021+内嵌 IPv4）",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "pptp": {
            "scenario": "tunnel_only",
            "data_frames": 1,
            "inner_ip": {
              "src_ip": "192.168.1.10",
              "dst_ip": "10.10.0.5",
              "payload": "inner-pkt"
            }
          }
        }
      ]
    },
    "expect": {
      "has_handshake": true,
      "terminates": true,
      "notes": [
        "inner_ip=object 内嵌 7 子键（registry object 型，srv6 先例）；payload 字符串=原文字节"
      ]
    }
  },
  {
