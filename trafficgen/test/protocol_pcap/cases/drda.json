        {
          "packet": 4,
          "field": "drda.ddm.format",
          "value": "0x01"
        },
        {
          "packet": 4,
          "field": "drda.ddm.rqscrr",
          "value": "1"
        },
        {
          "packet": 4,
          "field": "drda.ddm.length",
          "value": "10"
        },
        {
          "packet": 4,
          "field": "drda.ddm.length2",
          "value": "4"
        },
        {
          "packet": 4,
          "field": "drda.ddm.codepoint",
          "value": "0x1041"
        },
        {
          "packet": 5,
          "field": "drda.ddm.codepoint",
          "value": "0x1443"
        },
        {
          "packet": 5,
          "field": "drda.ddm.rqscrr",
          "same_as_packet": 4
        }
      ],
      "frames": [
        {
          "packet": 4,
          "offset": 54,
          "hex": "00 0a d0 01 00 01 00 04 10 41"
        },
        {
          "packet": 5,
          "offset": 54,
          "hex": "00 0a d0 01 00 01 00 04 14 43"
        }
      ],
      "notes": [
        "DDM 10 字节头与无参数代码点；TCP 载荷偏移=54。"
      ]
    }
  },
