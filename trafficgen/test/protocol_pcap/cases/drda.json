          "drda": {
            "association": "sql",
            "correlator_start": 1,
            "ccsid": 1208,
            "rdb_name": "SAMPLE",
            "sql": {
              "data": [
                1,
                2,
                3,
                4
              ],
              "code": 0,
              "state": "00000",
              "diagnostic": ""
            }
          }
        }
      ],
      "flow_control": {
        "flows": 1
      }
    },
    "expect": {
      "packet_count": 17,
      "has_handshake": true,
      "negotiated": true,
      "terminates": true,
      "has_payload": true,
      "directional": true,
      "fields": [
        {
          "packet": 12,
          "field": "drda.ddm.codepoint",
          "value": "0x2412"
        },
        {
          "packet": 13,
          "field": "drda.ddm.codepoint",
          "value": "0x2408"
        },
        {
          "packet": 13,
          "field": "drda.ddm.rqscrr",
          "same_as_packet": 12
        },
        {
          "packet": 13,
          "field": "tcp.len",
          "nonzero": true
        }
      ],
      "frames": [
        {
          "packet": 12,
          "offset": 62,
          "hex": "24 12"
        },
        {
          "packet": 13,
          "offset": 62,
          "hex": "24 08"
        },
        {
          "packet": 13,
          "offset": 64,
          "hex": "00 08 12 52 00 00 00 00 00 09 14 95 30 30 30 30 30"
        }
      ],
      "notes": [
        "SQLCARD 响应带 SQLCODE(0x1252)+SQLSTATE(0x1495) 参数（offset 64 = 参数区起点，链路径 layer_gen 语义）；SQLCODE=0、SQLSTATE=00000。"
      ]
    }
