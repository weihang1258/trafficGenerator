  {
    "id": "drda_sql_success",
    "proto": "drda",
    "summary": "T-DRDA-004/S4：SQLDTA→SQLCARD 成功 SQLCODE=0",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
