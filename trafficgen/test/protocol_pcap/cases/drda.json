        },
        {
          "packet": 4,
          "field": "drda.ddm.format",
          "value": "0x01"
        },
        {
          "packet": 4,
          "field": "drda.ddm.rqscrr",
          "value": "1"
        },
        {
          "packet": 4,
          "field": "drda.ddm.length",
          "value": "10"
        },
        {
          "packet": 4,
          "field": "drda.ddm.length2",
          "value": "4"
        },
        {
          "packet": 4,
          "field": "drda.ddm.codepoint",
          "value": "0x1041"
        },
        {
          "packet": 5,
          "field": "drda.ddm.codepoint",
          "value": "0x1443"
        },
        {
          "packet": 5,
          "field": "drda.ddm.rqscrr",
