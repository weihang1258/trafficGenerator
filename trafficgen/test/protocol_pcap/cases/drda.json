  {
    "id": "drda_multi_session",
    "proto": "drda",
    "summary": "T-DRDA-008/S8：两条独立 TCP 会话，各自 correlator 从 1 开始",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "tcp": {
            "src_port": 12345
          }
        },
        {
          "drda": {
            "association": "excsat",
            "ccsid": 1208,
            "sessions": [
              {
                "id": "s1",
                "src_port": 12345,
                "correlator_start": 1
              },
              {
                "id": "s2",
                "src_port": 12346,
                "correlator_start": 1
              }
            ]
          }
        }
      ],
      "flow_control": {
        "flows": 1
      }
    },
    "expect": {
      "packet_count": 18,
      "has_handshake": true,
      "negotiated": true,
      "terminates": true,
      "has_payload": true,
      "directional": true,
      "fields": [
        {
          "field": "tcp.srcport",
          "distinct_values": [
            "12345",
            "12346"
          ],
          "distinct_exclude": [
            "446"
          ]
        },
        {
          "field": "tcp.dstport",
          "distinct_values": [
            "446"
          ],
          "distinct_exclude": [
            "12345",
            "12346"
          ]
        }
      ],
      "frames": [
        {
          "packet": 4,
          "offset": 54,
          "hex": "00 0a d0 01 00 01 00 04 10 41"
        }
      ],
      "notes": [
        "两个 4-tuple/状态机独立；按 session 顺序输出仅是当前确定性契约。"
      ]
    }
  },
