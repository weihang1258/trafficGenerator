  {
    "id": "drda_excsat",
    "proto": "drda",
    "summary": "T-DRDA-001/S1：TCP 446 与 EXCSAT→EXCSATRD 关联建立",
    "spec_json": {
      "layers": [
        {
          "tcp": {}
        },
        {
          "drda": {}
        }
      ],
      "src_ip": "10.0.0.1",
      "dst_ip": "20.0.0.1",
      "src_port": 12345,
      "dst_port": 446,
      "count": 1,
      "drda": {
        "association": "excsat",
        "correlator_start": 1,
        "ccsid": 1208
