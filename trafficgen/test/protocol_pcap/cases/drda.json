  {
    "id": "drda_excsat",
    "proto": "drda",
    "summary": "T-DRDA-001/S1：TCP 446 与 EXCSAT→EXCSATRD 关联建立",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "tcp": {
            "src_port": 12345
          }
        },
        {
          "drda": {
            "association": "excsat",
            "correlator_start": 1,
            "ccsid": 1208
          }
        }
      ],
      "flow_control": {
        "flows": 1
      }
    },
    "expect": {
      "packet_count": 9,
      "has_handshake": true,
      "negotiated": true,
      "terminates": true,
      "has_payload": true,
      "directional": true,
