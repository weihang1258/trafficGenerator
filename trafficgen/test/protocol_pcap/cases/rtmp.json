            "data": [
              {
                "direction": "up",
                "msg_type": 8,
                "chunk_stream_id": 4,
                "payload_b64": "cnRtcC1kYXRh"
              }
            ]
          }
        }
      ]
    },
    "expect": {
      "has_handshake": true,
      "terminates": true,
      "notes": [
        "cnRtcC1kYXRh=rtmp-data；parse payload_b64 双形面（JSON 往返不可达，仅扁平 parse 单真相）"
      ]
    }
  },
  {
    "id": "rtmp_composite_publish_multi_data",
    "proto": "rtmp",
    "summary": "T-12 复合大场景（9.50）：publish+自定义 app/stream+音视频混合数据面 ≥3 类交织",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "rtmp": {
            "command": "publish",
            "app": "stream1",
            "stream_name": "cam1",
            "data": [
              {
                "direction": "up",
                "msg_type": 8,
                "chunk_stream_id": 4,
                "payload_b64": "YXVkaW8w"
              },
              {
                "direction": "up",
                "msg_type": 9,
                "chunk_stream_id": 6,
                "payload_b64": "dmlkZW8x"
              }
            ]
          }
        }
      ]
    },
    "expect": {
      "has_handshake": true,
      "terminates": true,
      "notes": [
        "推流+自定义 app+流名+音视频双 chunk 四类交织"
      ]
    }
  },
  {
    "id": "rtmp_neg_app_too_long",
    "proto": "rtmp",
    "summary": "T-13 负例：app 超 255B → 锚词 App exceeds",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "rtmp": {
            "app": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
          }
        }
      ]
    },
    "expect": {
      "expect_error": true,
      "error_contains": "App exceeds",
      "notes": [
        "Validate App 长度锚"
      ]
    }
  },
