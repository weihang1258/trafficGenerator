  {
    "id": "rtmp_data_payload_raw",
    "proto": "rtmp",
    "summary": "T-16 payload 显式原始串：payload 原文字节透传（getByteSlice 字符串=原文字节语义，pppoe cookie 同款陷阱注记）",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "rtmp": {
            "data": [
              {
                "direction": "up",
                "msg_type": 8,
                "chunk_stream_id": 4,
                "payload": "raw-frame"
              }
            ]
          }
        }
      ]
