      ]
    }
  },
  {
    "id": "rtmp_data_bidirectional",
    "proto": "rtmp",
    "summary": "T-10 数据面双向：up 音频+down 视频各一 chunk（推拉混合面）",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "rtmp": {
            "data": [
              {
                "direction": "up",
                "msg_type": 8,
                "chunk_stream_id": 4
              },
              {
                "direction": "down",
                "msg_type": 9,
                "chunk_stream_id": 6
              }
            ]
          }
        }
      ]
    },
    "expect": {
      "has_handshake": true,
      "terminates": true,
      "notes": [
        "两 chunk 方向序=命令面完成后逐条 PSH-ACK"
      ]
    }
  },
  {
    "id": "rtmp_data_payload_b64",
    "proto": "rtmp",
    "summary": "T-11 payload 显式 b64：payload_b64 解码字节透传（chunk 数据段 frames 钉）",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
