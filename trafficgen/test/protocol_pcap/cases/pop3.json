[
 {
  "id": "pop3_t001_default_session",
  "proto": "pop3",
  "summary": "T-001: 默认会话冒烟",
  "spec_json": {
   "layers": [
    {
     "ip": {
      "src": "10.0.0.1",
      "dst": "20.0.0.1"
     }
    },
    {
     "tcp": {
      "src_port": 13000,
      "dst_port": 110
     }
    },
    {
     "pop3": {
      "banner": "+OK POP3 server ready",
      "commands": [
       {
        "cmd": "USER alice",
        "response": "+OK alice"
       },
       {
        "cmd": "PASS secret",
        "response": "+OK Logged in"
       },
       {
        "cmd": "QUIT",
        "response": "+OK bye"
       }
      ]
     }
    }
   ]
  },
  "expect": {
   "has_handshake": true,
   "negotiated": true,
   "terminates": true,
   "fields": [
    {
     "packet": 1,
     "field": "tcp.dstport",
     "value": "110"
    },
    {
     "packet": 4,
     "field": "pop.response.indicator",
     "value": "+OK"
    },
    {
     "packet": 5,
     "field": "pop.request.command",
     "value": "USER"
    },
    {
     "packet": 5,
     "field": "pop.request.parameter",
     "value": "alice"
    },
    {
     "packet": 9,
     "field": "pop.request.command",
     "value": "QUIT"
    },
    {
     "packet": 10,
     "field": "pop.response.indicator",
     "value": "+OK"
    }
   ],
   "notes": [
    "POP3 短命令帧恒<80B（frame.len 代理不适用；mqtt/smtp 先例同款不断 has_payload）",
    "改写 pop3_smoke_01 纯扁平→[ip,tcp,pop3]；包位落盘重钉"
   ]
  }
 },
