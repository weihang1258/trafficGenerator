     "pop3": {
      "banner": "+OK POP3 server ready",
      "mailbox": {
       "messages": [
        {
         "uid": "u1",
         "headers": [
          "From: a@b.c",
          "Subject: T"
         ],
         "body": "hello"
        },
        {
         "uid": "u2",
         "headers": [
          "From: x@y.z"
         ]
        }
       ]
      },
      "commands": [
       {
        "cmd": "USER alice",
        "response": "+OK alice"
       },
       {
        "cmd": "PASS secret",
        "response": "+OK Logged in"
       },
       {
        "cmd": "RETR 1",
        "emit_mail_drop": true,
        "msg_num": 1
       },
       {
        "cmd": "QUIT",
        "response": "+OK bye"
       }
      ]
     }
    }
   ]
  },
  "expect": {
   "has_handshake": true,
   "terminates": true,
   "fields": [
    {
     "packet": 9,
     "field": "pop.request.command",
     "value": "RETR"
    },
    {
     "packet": 10,
     "field": "pop.response.indicator",
     "value": "+OK"
    }
   ],
   "notes": [
    "POP3 短命令帧恒<80B（frame.len 代理不适用；mqtt/smtp 先例同款不断 has_payload）",
    "EmitMailDrop 合成；MsgNum 2 空信附带空正文形态；包位落盘重钉"
   ]
  }
