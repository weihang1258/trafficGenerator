    "summary": "T-FTP-2: PASV+RETR 下载（层链），数据通道挂载在 150 与 226 之间；28 帧 = 控制通道 19 + 数据通道 9",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "tcp": {
            "src_port": 12345,
            "dst_port": 21
          }
        },
        {
          "ftp": {
            "banner": "220 FTP ready",
            "commands": [
              {
                "cmd": "USER anonymous",
                "response": "331"
              },
              {
                "cmd": "PASS guest",
                "response": "230"
              },
              {
                "cmd": "PASV",
                "response": "227 Entering Passive Mode (20,0,0,1,195,73)"
              },
              {
                "cmd": "RETR /data.bin",
                "response": "150 Opening data connection",
                "emit_data_channel": true
              },
              {
                "cmd": "",
                "response": "226 Transfer complete"
              },
              {
                "cmd": "QUIT",
                "response": "221 Goodbye"
              }
            ],
            "data_channel": {
              "mode": "passive",
              "direction": "down",
              "payload": "HELLO FTP DATA"
            }
          }
        }
      ]
    },
    "expect": {
      "min_packets": 27,
