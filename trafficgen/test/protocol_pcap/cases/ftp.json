  {
    "id": "ftp_smoke_01",
    "proto": "ftp",
    "summary": "FTP 控制通道冒烟：USER/PASS/QUIT（RFC 959 §4.1），14 帧 = 3 握手 + banner + 3 命令×2 + 4 终止",
    "spec_json": {
      "src_ip": "10.0.0.1",
      "dst_ip": "20.0.0.1",
      "src_port": 12345,
      "dst_port": 21,
      "count": 1,
      "ftp": {
        "banner": "220 FTP server ready",
        "commands": [
          {
            "cmd": "USER anonymous",
            "response": "331 Anonymous login ok"
          },
          {
            "cmd": "PASS guest",
            "response": "230 Logged in"
          },
          {
            "cmd": "QUIT",
            "response": "221 Goodbye"
          }
        ]
      }
    },
    "expect": {
      "min_packets": 14,
      "negotiated": true,
      "terminates": true,
      "fields": [
        {
          "packet": 1,
          "field": "tcp.dstport",
          "value": "21"
        },
        {
          "packet": 4,
          "field": "ftp.response.code",
          "value": "220"
        },
        {
          "packet": 4,
          "field": "ftp.response.arg",
          "value": "FTP server ready"
        },
        {
          "packet": 5,
          "field": "ftp.request.command",
          "value": "USER"
        },
        {
          "packet": 5,
          "field": "ftp.request.arg",
          "value": "anonymous"
        },
        {
          "packet": 6,
          "field": "ftp.response.code",
          "value": "331"
        },
        {
          "packet": 7,
          "field": "ftp.request.command",
          "value": "PASS"
        },
        {
          "packet": 8,
          "field": "ftp.response.code",
          "value": "230"
        },
        {
          "packet": 9,
          "field": "ftp.request.command",
          "value": "QUIT"
        },
        {
          "packet": 10,
          "field": "ftp.response.code",
          "value": "221"
        },
        {
          "packet": 10,
          "field": "ftp.response.arg",
          "value": "Goodbye"
        }
      ],
      "frames": [
        {
          "packet": 4,
          "offset": 54,
          "hex": "32 32 30 20"
        },
        {
          "packet": 5,
          "offset": 54,
          "hex": "55 53 45 52 20 61 6e 6f 6e 79 6d 6f 75 73 0d 0a"
        },
        {
          "packet": 10,
          "offset": 54,
          "hex": "32 32 31 20 47 6f 6f 64 62 79 65 0d 0a"
        }
      ],
      "notes": [
        "MCP 生成验证：14 帧 = 3hs + banner@4 + 3cmd×2@5-10 + 4teardown@11-14"
      ]
    }
  },
  {
    "id": "ftp_retr_passive",
    "proto": "ftp",
    "summary": "T-FTP-2: PASV+RETR 下载，数据通道挂载在 150 与 226 之间；28 帧 = 控制通道 19 + 数据通道 9",
    "spec_json": {
      "src_ip": "10.0.0.1",
      "dst_ip": "20.0.0.1",
      "src_port": 12345,
      "dst_port": 21,
      "count": 1,
      "ftp": {
        "banner": "220 FTP ready",
        "commands": [
          {
            "cmd": "USER anonymous",
            "response": "331"
          },
          {
            "cmd": "PASS guest",
            "response": "230"
          },
          {
            "cmd": "PASV",
            "response": "227 Entering Passive Mode (20,0,0,1,195,73)"
          },
          {
            "cmd": "RETR /data.bin",
            "response": "150 Opening data connection",
            "emit_data_channel": true
          },
          {
            "cmd": "",
            "response": "226 Transfer complete"
          },
          {
            "cmd": "QUIT",
            "response": "221 Goodbye"
          }
        ],
        "data_channel": {
          "mode": "passive",
          "direction": "down",
          "payload": "HELLO FTP DATA"
        }
      }
    },
    "expect": {
      "min_packets": 28,
      "packet_count": 28,
      "negotiated": true,
      "terminates": true,
      "has_handshake": true,
      "has_payload": true,
      "fields": [
        {
          "packet": 1,
          "field": "tcp.dstport",
          "value": "21"
        },
        {
          "packet": 10,
          "field": "ftp.response.code",
          "value": "227"
        },
        {
          "packet": 11,
          "field": "ftp.request.command",
          "value": "RETR"
        },
        {
          "packet": 11,
          "field": "ftp.request.arg",
          "value": "/data.bin"
        },
        {
          "packet": 12,
          "field": "ftp.response.code",
          "value": "150"
        },
        {
          "packet": 13,
          "field": "tcp.dstport",
          "value": "49993"
        },
        {
          "packet": 22,
          "field": "ftp.response.code",
          "value": "226"
        },
        {
          "packet": 23,
          "field": "ftp.request.command",
          "value": "QUIT"
        },
        {
          "packet": 24,
          "field": "ftp.response.code",
          "value": "221"
        }
      ],
      "notes": [
        "PASV port=195*256+73=49993；控制通道 19 包（空 cmd 只发响应 1 包）+ 数据通道 9 包 = 28；数据通道 SYN 在 pkt13"
      ]
    }
  },
