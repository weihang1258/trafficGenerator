  {
    "id": "ftp_smoke_01",
    "proto": "ftp",
    "summary": "FTP 控制通道冒烟（层链 [ip,tcp,ftp]）：USER/PASS/QUIT（RFC 959 §4.1），14 帧 = 3 握手 + banner + 3 命令×2 + 4 终止",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "tcp": {
            "src_port": 12345,
            "dst_port": 21
          }
        },
        {
          "ftp": {
            "banner": "220 FTP server ready",
            "commands": [
              {
                "cmd": "USER anonymous",
                "response": "331 Anonymous login ok"
              },
              {
                "cmd": "PASS guest",
                "response": "230 Logged in"
              },
              {
                "cmd": "QUIT",
                "response": "221 Goodbye"
              }
            ]
          }
        }
      ]
    },
    "expect": {
      "min_packets": 14,
      "negotiated": true,
      "terminates": true,
      "fields": [
        {
          "packet": 1,
          "field": "tcp.dstport",
          "value": "21"
        },
        {
          "packet": 4,
          "field": "ftp.response.code",
          "value": "220"
        },
        {
          "packet": 4,
          "field": "ftp.response.arg",
          "value": "FTP server ready"
        },
        {
          "packet": 5,
          "field": "ftp.request.command",
          "value": "USER"
        },
        {
          "packet": 5,
          "field": "ftp.request.arg",
          "value": "anonymous"
        },
        {
          "packet": 6,
          "field": "ftp.response.code",
          "value": "331"
        },
        {
          "packet": 7,
          "field": "ftp.request.command",
          "value": "PASS"
        },
        {
          "packet": 8,
          "field": "ftp.response.code",
          "value": "230"
        },
        {
          "packet": 9,
          "field": "ftp.request.command",
          "value": "QUIT"
        },
        {
          "packet": 10,
          "field": "ftp.response.code",
          "value": "221"
        },
        {
          "packet": 10,
          "field": "ftp.response.arg",
          "value": "Goodbye"
        }
      ],
      "frames": [
        {
          "packet": 4,
          "offset": 54,
          "hex": "32 32 30 20"
        },
        {
          "packet": 5,
          "offset": 54,
          "hex": "55 53 45 52 20 61 6e 6f 6e 79 6d 6f 75 73 0d 0a"
        },
        {
          "packet": 10,
          "offset": 54,
          "hex": "32 32 31 20 47 6f 6f 64 62 79 65 0d 0a"
        }
      ],
      "notes": [
        "链化（Task 6）：原扁平四元组+顶层 ftp 键 → ip/tcp/ftp 三层。14 帧 = 3hs + banner@4 + 3cmd×2@5-10 + 4teardown@11-14，与扁平基线逐字节同序"
      ]
    }
  },
  {
    "id": "ftp_retr_passive",
