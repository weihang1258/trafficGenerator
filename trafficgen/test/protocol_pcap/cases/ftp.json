      "negotiated": true,
      "terminates": true,
      "fields": [
        {
          "field": "tcp.srcport",
          "distinct_values": [
            "30000",
            "30001"
          ],
          "distinct_exclude": [
            "21",
            "50000",
            "30002"
          ]
        }
      ],
      "notes": [
        "每流 23 帧 = 控制 14 + 数据通道 9；流0=RETR file1（控制 30000，数据通道客户端口派生 30001），流1=RETR file2（控制 30001，数据通道 30002）；排除 server 21/50000 与数据通道派生端口 30002"
      ]
    }
  },
