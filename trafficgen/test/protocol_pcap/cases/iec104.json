    {
     "packet": 4,
     "field": "tcp.dstport",
     "value": "2404"
    },
    {
     "packet": 5,
     "field": "tcp.srcport",
     "value": "2404"
    },
    {
     "packet": 6,
     "field": "iec60870_104.apdulen",
     "value": "14"
    }
   ],
   "frames": [
    {
     "packet": 4,
     "offset": 54,
     "hex": "68 04 07 00 00 00"
    },
    {
     "packet": 5,
     "offset": 54,
     "hex": "68 04 0b 00 00 00"
    },
    {
     "packet": 6,
     "offset": 54,
