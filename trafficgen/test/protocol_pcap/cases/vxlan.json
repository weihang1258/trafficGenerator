  {
    "id": "vxlan_udp_checksum_profiles",
    "proto": "vxlan",
    "summary": "IPv4 UDP checksum zero profile vs auto nonzero profile",
    "spec_json": {
      "layers": [
        {
          "ip": {}
        },
        {
          "udp": {}
        },
        {
          "vxlan": {}
        }
      ],
      "src_ip": "192.0.2.140",
      "dst_ip": "198.51.100.140",
      "src_port": 40140,
      "dst_port": 4789,
      "vxlan": {
        "datagrams": [
          {
            "vni": 800,
            "inner": {
              "src_mac": "02:00:00:00:24:01",
              "dst_mac": "02:00:00:00:24:02",
              "ether_type": "ipv4",
              "src_ip": "10.140.0.1",
              "dst_ip": "10.140.0.2",
              "payload_b64": "Y2sx"
            }
          },
          {
            "vni": 801,
            "udp_checksum_zero": true,
            "inner": {
              "src_mac": "02:00:00:00:24:03",
              "dst_mac": "02:00:00:00:24:04",
              "ether_type": "ipv4",
              "src_ip": "10.140.0.3",
              "dst_ip": "10.140.0.4",
              "payload_b64": "Y2sy"
            }
          }
        ]
      }
    },
    "expect": {
      "packet_count": 2,
      "fields": [
        {
          "packet": 1,
          "field": "udp.checksum",
          "nonzero": true
        },
        {
          "packet": 2,
          "field": "udp.checksum",
          "value": "0x0000"
        },
        {
          "field": "vxlan.vni",
          "distinct_values": [
            "800",
            "801"
          ]
        }
      ],
      "notes": [
        "IPv4 outer 允许两种 profile：正确非零 checksum 与 RFC 768 的 0x0000（未计算）",
        "IPv6 outer 非零要求由用例 3（udp.checksum nonzero）覆盖",
        "事件级 udp_disable_checksum 元数据 → builder 写 0x0000"
      ]
    }
  },
