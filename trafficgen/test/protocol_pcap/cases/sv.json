  {
    "id": "sv_4i4v",
    "proto": "sv",
    "summary": "9-2LE full dataset 4 current + 4 voltage: seqData 64 bytes, per-channel instMag 30..135, quality good; also serves as the no-IP proof (eth:sv, no ip layer)",
    "spec_json": {
      "count": 1,
      "src_mac": "aa:bb:cc:dd:ee:03",
      "layers": [
        { "eth": {} },
        { "sv": {} }
      ],
      "sv": {
        "sv_id": "xxxxMUnn01",
        "appid": 16384,
        "conf_rev": 1,
        "samples_per_cycle": 4000,
        "smp_synch": 2,
        "smp_rate": 4000,
        "period_us": 250,
        "double_send": false,
        "vlan_enabled": false,
        "data": [
          {"name": "I_A", "type": "int32", "quality": 0, "inst_mag": 30},
          {"name": "I_B", "type": "int32", "quality": 0, "inst_mag": 45},
          {"name": "I_C", "type": "int32", "quality": 0, "inst_mag": 60},
          {"name": "I_N", "type": "int32", "quality": 0, "inst_mag": 75},
          {"name": "V_A", "type": "int32", "quality": 0, "inst_mag": 90},
          {"name": "V_B", "type": "int32", "quality": 0, "inst_mag": 105},
          {"name": "V_C", "type": "int32", "quality": 0, "inst_mag": 120},
          {"name": "V_N", "type": "int32", "quality": 0, "inst_mag": 135}
        ]
      }
    },
    "expect": {
      "min_packets": 1,
      "fields": [
        { "packet": 1, "field": "eth.type", "value": "0x88ba" },
        { "packet": 1, "field": "frame.protocols", "value": "eth:sv" },
        { "packet": 1, "field": "sv.smpCnt", "value": "0" }
      ],
      "frames": [
        { "packet": 1, "offset": 12, "hex": "88 ba" },
        { "packet": 1, "offset": 60, "hex": "87 40" },
        { "packet": 1, "offset": 62, "hex": "00 00 00 1e 00 00 00 00 00 00 00 2d 00 00 00 00" },
        { "packet": 1, "offset": 94, "hex": "00 00 00 5a 00 00 00 00 00 00 00 69 00 00 00 00" },
        { "packet": 1, "offset": 118, "hex": "00 00 00 87 00 00 00 00" }
      ],
      "notes": [
        "no-IP proof: offset 12 is EtherType 0x88ba (not 0x0800/0x86dd), frame.protocols == eth:sv with no ip segment (design §6.7)",
        "seqData 64 bytes = 8 channels x 8 (int32 instMag big-endian + 4B quality; design §2.7); instMag I_A=30 V_N=135 verified in hex",
        "10B svID shifts ASDU: seqData tag@60, data@62..125 (sv_smp_seq for the shared layout)",
        "if tshark supports PhsMeas decoding (-d sv.seqData,PhsMeas), sv.meas_value equals 30..135 and sv.meas_quality == 0; otherwise raw sv.seqData / FrameAssert hex above"
      ]
    }
  },
  {
    "id": "sv_custom_dataset",
    "proto": "sv",
    "summary": "non-9-2LE custom dataset: 2 channels (int32 + float32), no per-channel quality, smpRate field omitted (optional-field behavior), smpSynch 2",
    "spec_json": {
      "count": 1,
      "src_mac": "aa:bb:cc:dd:ee:03",
      "layers": [
        { "eth": {} },
        { "sv": {} }
      ],
      "sv": {
        "sv_id": "xxxxMUnn01",
        "appid": 16384,
        "conf_rev": 1,
        "samples_per_cycle": 4000,
        "smp_synch": 2,
        "period_us": 250,
        "double_send": false,
        "vlan_enabled": false,
        "data": [
          {"name": "I_A", "type": "int32", "inst_mag": 30},
          {"name": "V_A", "type": "float32", "inst_mag": 1.5}
        ]
      }
    },
    "expect": {
      "min_packets": 1,
      "fields": [
        { "packet": 1, "field": "sv.svID", "value": "xxxxMUnn01" },
        { "packet": 1, "field": "sv.smpCnt", "value": "0" },
        { "packet": 1, "field": "sv.smpSynch", "value": "2" }
      ],
      "frames": [
        { "packet": 1, "offset": 56, "hex": "87 08 00 00 00 1e 3f c0 00 00" }
      ],
      "notes": [
        "no smpRate config -> the 0x86 field is absent entirely; FrameAssert offset 56 shows seqData tag 0x87 directly after smpSynch (no 0x86 between) (design §6.6)",
        "10B svID shifts ASDU: seqData tag@56, data@58..65; frame SV Length = 52 = 0x34 (8 hdr + savPdu 36 + asdu) (design §2.4)",
        "channels: int32 30 = 0x1e, float32 1.5 = 0x3fc00000 big-endian; seqData 8 bytes",
        "frame length 60 = exactly minimal ethernet frame, no padding (14 + 8 hdr + 38 APDU = 60)"
      ]
    }
  },
  {
    "id": "sv_vlan",
    "proto": "sv",
    "summary": "802.1Q VLAN on SV: vlan_id 100, priority 4 -> TCI 0x8064 inserted before EtherType 0x88ba",
    "spec_json": {
      "count": 1,
      "src_mac": "aa:bb:cc:dd:ee:03",
      "layers": [
        { "eth": {} },
        { "sv": {} }
      ],
      "sv": {
        "sv_id": "xxxxMUnn01",
        "appid": 16384,
        "conf_rev": 1,
        "samples_per_cycle": 4000,
        "smp_synch": 2,
        "smp_rate": 4000,
        "period_us": 250,
        "double_send": false,
        "vlan_enabled": true,
        "vlan_id": 100,
        "vlan_priority": 4,
        "data": [
          {"name": "I_A", "type": "int32", "quality": 0}
        ]
      }
    },
    "expect": {
      "min_packets": 1,
      "fields": [
        { "packet": 1, "field": "vlan.id", "value": "100" },
        { "packet": 1, "field": "vlan.priority", "value": "4" },
        { "packet": 1, "field": "eth.type", "value": "0x88ba" },
        { "packet": 1, "field": "frame.protocols", "value": "eth:vlan:sv" }
      ],
      "frames": [
        { "packet": 1, "offset": 12, "hex": "81 00 80 64 88 ba" }
      ],
      "notes": [
        "TCI = priority(4)<<13 + DEI(0)<<12 + VID(100) = 0x8000 + 0x64 = 0x8064 (design §2.2/§6.8)",
        "all SV-header/APDU offsets shift +4 when VLAN present"
      ]
    }
  },
  {
    "id": "sv_period",
    "proto": "sv",
    "summary": "sampling period stability: period_us 250, 100 frames delivered (redundancy of the period-driven sender); timing asserted via time_delta sampling",
    "spec_json": {
      "count": 100,
      "src_mac": "aa:bb:cc:dd:ee:03",
      "layers": [
        { "eth": {} },
        { "sv": {} }
      ],
      "sv": {
        "sv_id": "xxxxMUnn01",
        "appid": 16384,
