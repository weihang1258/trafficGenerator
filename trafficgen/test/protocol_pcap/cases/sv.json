        "vlan_enabled": false,
        "data": [
          {"name": "I_A", "type": "int32", "quality": 0}
        ]
      }
    },
    "expect": {
      "min_packets": 100,
      "fields": [
        { "packet": 1, "field": "sv.smpCnt", "value": "0" }
      ],
      "notes": [
        "100 frames at period 250us; captures of long streams assert frame.time_delta ~250us (+/- tolerance) and frame.time_relative monotonic (design §4.8/§6.9)",
        "if the framework cannot read time fields, period correctness is covered by unit tests on the ticker plus this packet-count bound"
      ]
    }
  },
