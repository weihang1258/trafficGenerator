[
  {
    "id": "sv_smp_seq",
    "proto": "sv",
    "summary": "9-2LE base sampled-value stream: 3 frames, smpCnt 0/1/2 incrementing, appid 0x4000, length 0x6A(=106), confRev 1, no VLAN, no IP (eth:sv)",
    "spec_json": {
      "count": 3,
      "src_mac": "aa:bb:cc:dd:ee:03",
      "layers": [
        { "eth": {} },
        { "sv": {} }
      ],
      "sv": {
        "sv_id": "xxxxMUnn01",
        "appid": 16384,
        "conf_rev": 1,
        "samples_per_cycle": 4000,
        "smp_synch": 2,
        "smp_rate": 4000,
        "period_us": 250,
        "double_send": false,
        "dst_mac": "01:0c:cd:04:00:01",
        "vlan_enabled": false,
        "data": [
          {"name": "I_A", "type": "int32", "quality": 0},
          {"name": "I_B", "type": "int32", "quality": 0},
          {"name": "I_C", "type": "int32", "quality": 0},
          {"name": "I_N", "type": "int32", "quality": 0},
          {"name": "V_A", "type": "int32", "quality": 0},
          {"name": "V_B", "type": "int32", "quality": 0},
          {"name": "V_C", "type": "int32", "quality": 0},
          {"name": "V_N", "type": "int32", "quality": 0}
        ]
      }
    },
    "expect": {
      "packet_count": 3,
      "fields": [
        { "packet": 1, "field": "sv.appid", "value": "0x4000" },
        { "packet": 1, "field": "sv.length", "value": "112" },
        { "packet": 1, "field": "sv.reserve1", "value": "0" },
        { "packet": 1, "field": "sv.reserve2", "value": "0" },
        { "packet": 1, "field": "sv.svID", "value": "xxxxMUnn01" },
        { "packet": 1, "field": "sv.smpCnt", "value": "0" },
        { "packet": 2, "field": "sv.smpCnt", "value": "1" },
        { "packet": 3, "field": "sv.smpCnt", "value": "2" },
        { "packet": 1, "field": "sv.confRev", "value": "1" },
        { "packet": 2, "field": "sv.confRev", "same_as_packet": 1 },
        { "packet": 1, "field": "sv.smpSynch", "value": "2" },
        { "packet": 1, "field": "sv.smpRate", "value": "4000" },
        { "packet": 1, "field": "sv.noASDU", "value": "1" }
      ],
      "frames": [
        { "packet": 1, "offset": 14, "hex": "40 00 00 70 00 00 00 00" },
        { "packet": 1, "offset": 22, "hex": "60 66 80 01 01 a2 61 30 5f" },
        { "packet": 1, "offset": 31, "hex": "80 0a 78 78 78 78 4d 55 6e 6e 30 31" },
        { "packet": 1, "offset": 43, "hex": "82 02 00 00 83 04 00 00 00 01 85 01 02 86 02 0f a0 87 40" }
      ],
      "notes": [
        "frame = 14 eth + 8 SV hdr + 104 APDU = 126B; SV Length field counts from APPID: 8 + 104 = 112 = 0x70 (10B svID; old 4B-SV01 template was wrong, see sv_4i4v/sv_custom_dataset frames renumbered +6/+12)",
        "ASDU fields (10B svID xxxxMUnn01): smpCnt@43 82 02 + confRev@47 83 04 + smpSynch@53 85 01 + smpRate@56 86 02 0f a0 + seqData tag@60 87 40"
      ]
    }
  },
  {
    "id": "sv_double_send",
    "proto": "sv",
    "summary": "redundant double-send: same smpCnt appears twice (2 frames identical bytes), then stream continues; count 6 -> smpCnt 0,0,1,1,2,2",
    "spec_json": {
      "count": 6,
      "src_mac": "aa:bb:cc:dd:ee:03",
      "layers": [
        { "eth": {} },
        { "sv": {} }
      ],
      "sv": {
        "sv_id": "xxxxMUnn01",
        "appid": 16384,
        "conf_rev": 1,
        "samples_per_cycle": 4000,
        "smp_synch": 2,
        "smp_rate": 4000,
        "period_us": 250,
        "double_send": true,
        "vlan_enabled": false,
        "data": [
          {"name": "I_A", "type": "int32", "quality": 0}
        ]
      }
    },
    "expect": {
      "packet_count": 6,
      "fields": [
        { "packet": 1, "field": "sv.smpCnt", "value": "0" },
        { "packet": 2, "field": "sv.smpCnt", "value": "0" },
        { "packet": 3, "field": "sv.smpCnt", "value": "1" },
        { "packet": 4, "field": "sv.smpCnt", "value": "1" },
        { "packet": 5, "field": "sv.smpCnt", "value": "2" },
        { "packet": 6, "field": "sv.smpCnt", "value": "2" },
        { "packet": 2, "field": "sv.confRev", "same_as_packet": 1 }
      ],
      "frames": [
        { "packet": 1, "offset": 0, "hex": "01 0c cd 04 00 01" },
        { "packet": 1, "offset": 14, "hex": "40 00 00 38 00 00 00 00" },
        { "packet": 1, "offset": 22, "hex": "60 2e 80 01 01 a2 29 30 27" },
        { "packet": 2, "offset": 0, "hex": "01 0c cd 04 00 01" },
        { "packet": 2, "offset": 14, "hex": "40 00 00 38 00 00 00 00" },
        { "packet": 2, "offset": 22, "hex": "60 2e 80 01 01 a2 29 30 27" }
      ],
      "notes": [
        "same smpCnt twice = redundancy report; the two frames differ only in frame number, content bytes identical (design §4.6/§6.2)",
        "distinct smpCnt values are [0,1,2] each appearing exactly 2 times"
      ]
    }
  },
  {
    "id": "sv_smp_wrap",
    "proto": "sv",
    "summary": "smpCnt wrap-around: samples_per_cycle=4 -> smpCnt 0,1,2,3,0,1 (wrap at 3->0, never 4); 6 frames",
    "spec_json": {
      "count": 6,
      "src_mac": "aa:bb:cc:dd:ee:03",
      "layers": [
        { "eth": {} },
        { "sv": {} }
      ],
      "sv": {
        "sv_id": "xxxxMUnn01",
        "appid": 16384,
        "conf_rev": 1,
        "samples_per_cycle": 4,
        "smp_synch": 2,
        "smp_rate": 400,
        "period_us": 2500,
        "double_send": false,
        "vlan_enabled": false,
        "data": [
          {"name": "I_A", "type": "int32", "quality": 0}
        ]
      }
    },
    "expect": {
      "packet_count": 6,
      "fields": [
        { "packet": 1, "field": "sv.smpCnt", "value": "0" },
        { "packet": 2, "field": "sv.smpCnt", "value": "1" },
        { "packet": 3, "field": "sv.smpCnt", "value": "2" },
        { "packet": 4, "field": "sv.smpCnt", "value": "3" },
        { "packet": 5, "field": "sv.smpCnt", "value": "0" },
        { "packet": 6, "field": "sv.smpCnt", "value": "1" }
      ],
      "notes": [
        "wrap is samples_per_cycle-1 -> 0, never reaching samples_per_cycle (4); stream continues after wrap (design §4.3/§6.3)",
        "relative-wrap variant keeps packet_count low; the 9-2LE 4000 wrap is exercised by config value and the same code path"
      ]
    }
  },
  {
    "id": "sv_neg_wrap",
    "proto": "sv",
    "summary": "negative: samples_per_cycle=0 (illegal wrap/cycle count <1) must fail the task",
    "spec_json": {
      "count": 3,
      "src_mac": "aa:bb:cc:dd:ee:03",
      "layers": [
        { "eth": {} },
        { "sv": {} }
      ],
      "sv": {
        "sv_id": "xxxxMUnn01",
        "appid": 16384,
        "conf_rev": 1,
        "samples_per_cycle": 0,
        "smp_synch": 2,
        "vlan_enabled": false,
        "data": [
          {"name": "I_A", "type": "int32", "quality": 0}
        ]
      }
    },
    "expect": {
      "expect_error": true,
      "error_contains": "samples_per_cycle",
      "notes": [
        "design §9.1: samples_per_cycle < 1 rejected; smpCnt is 16-bit, wrap must be >= 1 and <= 65535",
        "expected error: 'samples_per_cycle must be >= 1'"
      ]
    }
  },
  {
    "id": "sv_smp_synch_global",
    "proto": "sv",
    "summary": "smpSynch field stable at 2 (global/PTP sync) across all frames of the stream",
    "spec_json": {
      "count": 4,
      "src_mac": "aa:bb:cc:dd:ee:03",
      "layers": [
        { "eth": {} },
        { "sv": {} }
      ],
      "sv": {
        "sv_id": "xxxxMUnn01",
        "appid": 16384,
        "conf_rev": 1,
        "samples_per_cycle": 4000,
        "smp_synch": 2,
        "smp_rate": 4000,
        "period_us": 250,
        "double_send": false,
        "vlan_enabled": false,
        "data": [
          {"name": "I_A", "type": "int32", "quality": 0}
        ]
      }
    },
    "expect": {
      "min_packets": 4,
      "fields": [
        { "packet": 1, "field": "sv.smpSynch", "value": "2" },
        { "packet": 2, "field": "sv.smpSynch", "same_as_packet": 1 },
        { "packet": 3, "field": "sv.smpSynch", "same_as_packet": 1 },
        { "packet": 4, "field": "sv.smpSynch", "same_as_packet": 1 }
      ],
      "notes": [
        "smpSynch 2 = global clock (PTP synchronized); value is stable per-frame, not an event (design §4.4/§6.4)",
        "switch-to-2 across a config boundary is covered by design; single-task case asserts stability"
      ]
    }
  },
  {
