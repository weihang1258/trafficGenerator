    "summary": "negative: smp_synch=5 (legal set is {0,1,2}) must fail the task",
    "spec_json": {
      "count": 3,
      "src_mac": "aa:bb:cc:dd:ee:03",
      "layers": [
        { "eth": {} },
        { "sv": {} }
      ],
