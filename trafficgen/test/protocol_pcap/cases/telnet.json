[
 {
  "id": "telnet_basic_session",
  "proto": "telnet",
  "summary": "冒烟：TCP 3握手+defaultDialog 6事件+4挥手=13包（存量等价迁移）",
  "spec_json": {
   "layers": [
    {
     "ip": {
      "src": "10.0.0.1",
      "dst": "20.0.0.1"
     }
    },
    {
     "telnet": {
      "src_port": 12345,
      "dst_port": 23
     }
    }
   ]
  },
  "expect": {
   "has_handshake": true,
   "negotiated": true,
   "terminates": true,
   "min_packets": 12,
   "fields": [
    {
     "packet": 1,
     "field": "tcp.flags",
     "value": "0x002"
    },
    {
     "packet": 1,
     "field": "tcp.dstport",
     "value": "23"
    },
    {
     "packet": 2,
     "field": "tcp.flags",
     "value": "0x012"
    },
    {
     "packet": 3,
     "field": "tcp.flags",
     "value": "0x010"
    },
    {
     "packet": 6,
     "field": "telnet.data",
     "value": "login:"
    },
    {
     "packet": 7,
     "field": "telnet.data",
     "value": "alice\\r\\n"
    },
    {
     "packet": 8,
     "field": "telnet.data",
     "value": "$"
    },
    {
     "packet": 9,
     "field": "telnet.data",
     "value": "exit\\r\\n"
    }
   ],
   "frames": [
    {
     "packet": 4,
     "offset": 54,
     "hex": "ff fb 03"
    },
    {
     "packet": 5,
     "offset": 54,
     "hex": "ff fd 03"
    },
    {
     "packet": 6,
     "offset": 54,
     "hex": "6c 6f 67 69 6e 3a 20"
    },
    {
     "packet": 7,
     "offset": 54,
     "hex": "61 6c 69 63 65 0d 0a"
    },
    {
     "packet": 8,
     "offset": 54,
     "hex": "24 20"
    },
    {
     "packet": 9,
     "offset": 54,
     "hex": "65 78 69 74 0d 0a"
    }
   ],
   "notes": [
    "T-TELNET-1 改写：count 删、顶层 telnet:{}→telnet 层（业务面空+端口 12345/23 显式）、四元组→ip 层显式；8 fields+6 frames+4 标量保留等价——字节一致由 P5 实证",
    "tshark 伪影：telnet.data 对 IAC 帧输出空串；trim 尾部空白（'login: '→'login:'）；\\r\\n 显示字面转义——字节面以 frames 断言为准",
    "f4 ff fb 03=IAC WILL SGA(3)（存量 notes 'Will Echo' 注释有误不迁移）；f5 ff fd 03=IAC DO SGA",
    "min_packets 12=存量保守下界（实际 13 包=3+6+4）——P5 校准后可钉 13"
   ]
  }
 },
