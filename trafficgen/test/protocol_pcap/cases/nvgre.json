            "vsid": 6000,
            "flow_id": 1,
            "inner": {
              "src_mac": "02:aa:00:00:00:13",
              "dst_mac": "02:bb:00:00:00:13",
              "ether_type": "vlan_ipv4",
              "vlan_id": 100,
              "vlan_priority": 3,
              "src_ip": "172.16.13.1",
              "dst_ip": "172.16.13.2",
              "payload_b64": "bnZncmUtdnNpZGEtcGF5bG9hZA=="
            }
          }
        }
      ]
    },
    "expect": {
      "packet_count": 1,
      "has_payload": true,
      "fields": [
        {
          "packet": 1,
          "field": "ip.proto",
          "value": "47,253"
        },
        {
          "packet": 1,
          "field": "gre.proto",
          "value": "0x6558"
        },
        {
          "packet": 1,
          "field": "eth.type",
          "value": "0x0800,0x8100"
        },
        {
          "packet": 1,
          "field": "vlan.id",
          "value": "100"
        },
        {
          "packet": 1,
          "field": "vlan.priority",
          "value": "3"
        }
      ],
      "frames": [
        {
          "packet": 1,
          "offset": 42,
          "hex": "02 bb 00 00 00 13"
        },
        {
          "packet": 1,
          "offset": 54,
          "hex": "81 00 60 64"
        },
        {
          "packet": 1,
          "offset": 58,
          "hex": "08 00"
        }
      ],
      "notes": [
        "内层 VLAN tag 从 inner Ethernet 起点 42+12=54 起（TPID 81 00, TCI 60 64 = PCP3<<13|VID100）",
        "tshark 解 TEB payload 为 Ethernet：vlan.* 字段来自内层 tag"
      ]
    },
    "notes": [
      "层链改造：扁平四元组并入 ip/udp 层，顶层 nvgre 子映射迁入 layers[].nvgre"
    ]
  },
