[
  {
    "id": "nvgre_basic_ipv4_inner_ipv4",
    "proto": "nvgre",
    "summary": "outer IPv4/47 GRE + TEB + inner Ethernet/IPv4: flags 0x2000, protocol 0x6558, key, inner MAC/EtherType/IP",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "192.0.2.10",
            "dst": "198.51.100.10"
          }
        },
        {
          "udp": {}
        },
        {
          "nvgre": {
            "vsid": 1000,
            "flow_id": 1,
            "inner": {
              "src_mac": "02:aa:00:00:00:01",
              "dst_mac": "02:bb:00:00:00:01",
              "ether_type": "ipv4",
              "src_ip": "172.16.1.1",
              "dst_ip": "172.16.1.2",
              "payload_b64": "bnZncmUtaW5uZXItMDE="
            }
          }
        }
      ]
    },
    "expect": {
      "packet_count": 1,
      "has_payload": true,
      "fields": [
        {
          "packet": 1,
          "field": "ip.proto",
          "value": "47,253"
        },
        {
          "packet": 1,
          "field": "gre.proto",
          "value": "0x6558"
        },
        {
          "packet": 1,
          "field": "gre.flags_and_version",
          "value": "0x2000"
        },
        {
          "packet": 1,
          "field": "gre.key",
          "value": "0x0003e801"
        },
        {
          "packet": 1,
          "field": "eth.src",
          "value": "02:00:00:00:00:01,02:aa:00:00:00:01"
        },
        {
          "packet": 1,
          "field": "eth.dst",
          "value": "02:00:00:00:00:02,02:bb:00:00:00:01"
        },
        {
          "packet": 1,
          "field": "ip.src",
          "value": "192.0.2.10,172.16.1.1"
        }
      ],
      "frames": [
        {
          "packet": 1,
          "offset": 34,
          "hex": "20 00 65 58"
        },
        {
          "packet": 1,
          "offset": 38,
          "hex": "00 03 e8 01"
        },
        {
          "packet": 1,
          "offset": 42,
          "hex": "02 bb 00 00 00 01"
        },
        {
          "packet": 1,
          "offset": 48,
          "hex": "02 aa 00 00 00 01"
        },
        {
          "packet": 1,
          "offset": 54,
          "hex": "08 00"
        }
      ],
      "notes": [
        "GRE key 1000 = VSID(1000)<<8 | FlowID(1) = 0x03E801（网络字节序）",
        "gre.key 值格式（hex 0x03e801 vs decimal 255489）以实际 tshark 3.6.14 校准；如为后者，本用例按实际改值",
        "inner Ethernet 从 offset 42 起（IPv4 outer 固定偏移）"
      ]
    },
    "notes": [
      "层链改造：扁平四元组并入 ip/udp 层，顶层 nvgre 子映射迁入 layers[].nvgre"
    ]
  },
