  {
    "id": "nvgre_inner_vlan",
    "proto": "nvgre",
    "summary": "inner 802.1Q: TPID 0x8100, TCI=PCP<<13|VID, post-VLAN EtherType + inner IP",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "192.0.2.90",
            "dst": "198.51.100.90"
          }
        },
        {
          "udp": {}
        },
        {
