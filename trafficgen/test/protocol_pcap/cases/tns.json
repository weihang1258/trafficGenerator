            "events": [
              {
                "type": "CONNECT",
                "direction": "c2s",
                "payload_profile": "connect_basic"
              },
              {
                "type": "ACCEPT",
                "direction": "s2c",
                "payload_profile": "accept_basic"
              }
            ]
          }
        ]
      }
    },
    "expect": {
      "packet_count": 18,
      "has_handshake": true,
      "terminates": true,
      "fields": [
        {
          "packet": 0,
          "field": "tcp.srcport",
          "distinct_values": [
            "12345",
            "12346"
          ],
          "distinct_exclude": [
            "1521"
          ]
        },
        {
          "packet": 0,
          "field": "tcp.dstport",
          "distinct_values": [
            "1521"
          ],
          "distinct_exclude": [
            "12345",
            "12346"
          ]
        },
        {
          "packet": 0,
          "field": "tns.type",
          "distinct_values": [
            "1",
            "2"
          ]
        }
      ],
      "notes": [
        "S6: flow ordering is scheduler-dependent; distinct_values aggregate over both streams."
      ]
    },
    "notes": [
