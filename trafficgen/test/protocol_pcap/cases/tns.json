    "expect": {
      "packet_count": 18,
      "has_handshake": true,
      "terminates": true,
      "fields": [
        {
          "packet": 0,
          "field": "tcp.srcport",
          "distinct_values": [
            "41234",
            "41235"
          ],
          "distinct_exclude": [
            "1521"
          ]
        },
        {
          "packet": 0,
          "field": "tcp.dstport",
          "distinct_values": [
            "1521"
          ],
          "distinct_exclude": [
            "41234",
            "41235"
          ]
        },
        {
          "packet": 0,
          "field": "tns.type",
          "distinct_values": [
            "1",
            "2"
          ]
        }
      ],
      "notes": [
        "S6: flow ordering is scheduler-dependent; distinct_values aggregate over both streams."
      ]
