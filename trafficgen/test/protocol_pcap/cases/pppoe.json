          "value": "0x65"
        },
        {
          "packet": 4,
          "field": "pppoe.session_id",
          "value": "0x0001"
        },
        {
          "packet": 5,
          "field": "eth.type",
          "value": "0x8864"
        },
        {
          "packet": 5,
          "field": "pppoe.code",
          "value": "0x00"
        },
        {
          "packet": 5,
          "field": "pppoe.session_id",
          "value": "0x0001"
        },
        {
          "packet": 5,
          "field": "ppp.protocol",
          "value": "0xc021"
