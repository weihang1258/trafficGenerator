          "value": "0x0021"
        },
        {
          "packet": 7,
          "field": "ip.proto",
          "value": "17"
        },
        {
          "packet": 8,
          "field": "eth.type",
          "value": "0x8863"
        },
        {
          "packet": 8,
          "field": "pppoe.code",
          "value": "0xa7"
        },
        {
          "packet": 8,
          "field": "pppoe.session_id",
          "value": "0x0001"
        }
      ],
      "frames": [
        {
          "packet": 1,
          "offset": 14,
          "hex": "11 09 00 00 00 04"
        },
        {
          "packet": 5,
          "offset": 14,
          "hex": "11 00 00 01 00 10"
        },
        {
          "packet": 5,
          "offset": 20,
          "hex": "c0 21 01 01 00 0e"
        },
        {
          "packet": 8,
          "offset": 14,
          "hex": "11 a7 00 01 00 00"
        }
      ],
      "notes": [
        "PADT 缺省 true（D-PPPOE-1 裁定3，RFC 2516 §5.6）：原 7 帧 smoke 增第 8 帧 PADT",
        "PPPoE 头 offset 14：ver/type 0x11+code+session_id+payload_length；Discovery 段 session_id=0，PADS 起回显缺省 1",
        "LCP options=MRU(01 04 05 d4)+Magic(05 06 随机)→LCP len 0x000e、payload_length 0x0010；magic 字节随机不断言",
        "数据帧 inner IPv4/UDP，链路径无端口位→srcport/dstport=0（合成面，B′ 注记）；断言 ip.proto=17",
        "PADT=up 方向零 TLV（payload_length 0x0000）"
      ]
    }
  },
  {
    "id": "pppoe_padt_suppressed",
    "proto": "pppoe",
    "summary": "T-2 padt=false 抑制终止帧：7 帧（无 0xa7），帧序与 T-1 前 7 帧一致。RFC 2516 §5.6 拆断语义反向面",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "pppoe": {
            "padt": false
          }
        }
      ]
    },
    "expect": {
      "packet_count": 7,
      "fields": [
        {
          "packet": 1,
          "field": "pppoe.code",
          "value": "0x09"
        },
        {
          "packet": 4,
          "field": "pppoe.code",
          "value": "0x65"
        },
        {
          "packet": 7,
          "field": "ppp.protocol",
          "value": "0x0021"
        }
      ],
      "notes": [
        "padt:false 指针三态（*bool false=抑制）；末帧=数据帧非 PADT"
      ]
    }
  },
  {
    "id": "pppoe_skip_discovery",
    "proto": "pppoe",
    "summary": "T-3 skip_discovery=true+显式 session_id=9：LCP req/ack+data+PADT 4 帧，全部回显 9，首帧即 0x8864 会话面",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "pppoe": {
            "skip_discovery": true,
            "session_id": 9
          }
        }
      ]
    },
    "expect": {
      "packet_count": 4,
      "fields": [
        {
          "packet": 1,
          "field": "eth.type",
          "value": "0x8864"
        },
        {
          "packet": 1,
          "field": "pppoe.code",
          "value": "0x00"
        },
        {
          "packet": 1,
          "field": "pppoe.session_id",
          "value": "0x0009"
        },
        {
          "packet": 1,
          "field": "ppp.protocol",
          "value": "0xc021"
        },
        {
          "packet": 3,
          "field": "ppp.protocol",
          "value": "0x0021"
        },
        {
          "packet": 4,
          "field": "pppoe.code",
          "value": "0xa7"
        },
        {
          "packet": 4,
          "field": "pppoe.session_id",
          "value": "0x0009"
        }
      ],
      "notes": [
        "skip_discovery 跳过 §5.1-5.4 四步，PADS 缺席故 session_id 必须显式"
      ]
    }
  },
  {
    "id": "pppoe_auth_none_lcp_len",
    "proto": "pppoe",
    "summary": "T-4 auth=none：LCP options=MRU+Magic 无 Auth-Protocol（type3）分支→LCP len 0x000e/payload_length 0x0010 钉",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "pppoe": {
            "auth": "none"
          }
        }
      ]
    },
    "expect": {
      "packet_count": 8,
      "fields": [
        {
          "packet": 5,
          "field": "ppp.protocol",
          "value": "0xc021"
        }
      ],
      "frames": [
        {
          "packet": 5,
          "offset": 14,
          "hex": "11 00 00 01 00 10"
        },
        {
          "packet": 5,
          "offset": 20,
          "hex": "c0 21 01 01 00 0e"
        }
      ],
      "notes": [
        "无 auth 选项时 LCP Configure-Request 总长 14（4+MRU 4+Magic 6），RFC 1661 §6.1"
      ]
    }
  },
  {
    "id": "pppoe_auth_pap",
    "proto": "pppoe",
    "summary": "T-5 auth=pap：LCP 带 Auth-Protocol c023 选项+PAP Authenticate-Request(up)/Ack(down) 0xc023 两帧。RFC 1334 §2.1",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "pppoe": {
            "auth": "pap",
            "username": "alice",
            "password": "s3cret"
          }
        }
      ]
    },
    "expect": {
      "packet_count": 10,
      "fields": [
        {
          "packet": 5,
          "field": "ppp.protocol",
          "value": "0xc021"
        },
        {
          "packet": 7,
          "field": "ppp.protocol",
          "value": "0xc023"
        },
        {
          "packet": 8,
          "field": "ppp.protocol",
          "value": "0xc023"
        },
        {
          "packet": 9,
          "field": "ppp.protocol",
          "value": "0x0021"
        },
        {
          "packet": 10,
          "field": "pppoe.code",
          "value": "0xa7"
        }
      ],
      "frames": [
        {
          "packet": 5,
          "offset": 14,
          "hex": "11 00 00 01 00 14"
        },
        {
          "packet": 5,
          "offset": 20,
          "hex": "c0 21 01 01 00 12"
        },
        {
          "packet": 7,
          "offset": 20,
          "hex": "c0 23 01 01 00 11"
        }
      ],
      "notes": [
        "LCP len=4+MRU 4+Magic 6+AuthProto 4=18=0x12，payload_length 0x0014（Auth-Protocol 选项 4B：type 3+len 4+c023）",
        "PAP req：code 1+id 1+len 0x0011(6+alice5+s3cret6)+peer-id/password；Ack：code 2+msg welcome"
      ]
    }
  },
  {
    "id": "pppoe_auth_chap",
    "proto": "pppoe",
    "summary": "T-6 auth=chap：Challenge(down)/Response(up)/Success(down) 0xc223 三帧，value 16B（响应回显挑战值）。RFC 1994 §3",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "pppoe": {
            "auth": "chap",
            "username": "bob"
          }
        }
      ]
    },
    "expect": {
      "packet_count": 11,
      "fields": [
        {
          "packet": 7,
          "field": "ppp.protocol",
          "value": "0xc223"
        },
        {
          "packet": 8,
          "field": "ppp.protocol",
          "value": "0xc223"
        },
        {
          "packet": 9,
          "field": "ppp.protocol",
          "value": "0xc223"
        },
        {
          "packet": 10,
          "field": "ppp.protocol",
          "value": "0x0021"
        }
      ],
      "frames": [
        {
          "packet": 7,
          "offset": 20,
          "hex": "c2 23 01 01 00 18"
        }
      ],
      "notes": [
        "Challenge len=4+1(value-size)+16(value)+bob3=24=0x0018；pppoe payload_length=2+24=0x001a（另断言面）",
        "Success len=4（code/id/length 无 message）；挑战值 crypto/rand 随机，回显关系由包 8 value==包 7 value 保证（planner 合成）"
      ]
    }
  },
  {
    "id": "pppoe_data_direction_down",
    "proto": "pppoe",
    "summary": "T-7 data_direction=down：数据帧 MAC/IP 全换向（server→client），ip.src=20.0.0.1；LCP/PADT 方向不变",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "pppoe": {
            "skip_discovery": true,
            "session_id": 3,
            "data_direction": "down"
          }
        }
      ]
    },
    "expect": {
      "packet_count": 4,
      "fields": [
        {
          "packet": 3,
          "field": "ip.src",
          "value": "20.0.0.1"
        },
        {
          "packet": 3,
          "field": "ip.dst",
          "value": "10.0.0.1"
        },
        {
          "packet": 3,
          "field": "eth.src",
          "value": "02:00:00:00:00:02"
        }
      ],
      "notes": [
        "down=服务端下发面：inner IP 换向+eth.src 取 spec 缺省下行 MAC 02:00:00:00:00:02"
      ]
    }
  },
  {
