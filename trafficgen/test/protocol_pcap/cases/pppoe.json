  {
    "id": "pppoe_composite_multi_session",
    "proto": "pppoe",
    "summary": "T-14 复合大场景（9.50）：顶层 chap 模板共享+sessions[2] 交织——[0] 完整发现+data 1；[1] skip_discovery+down+data_frames 2。19 包",
