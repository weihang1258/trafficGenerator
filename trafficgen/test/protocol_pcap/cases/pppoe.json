      ]
    }
  },
  {
    "id": "pppoe_bras_three_tags",
    "proto": "pppoe",
    "summary": "T-10 BRAS 三标签形：service_name=internet+ac_name=BRAS-1+cookie=deadbeef→PADO 3 标签+PADR echo AC-Cookie（现网 9.10）",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "pppoe": {
            "service_name": "internet",
            "ac_name": "BRAS-1",
            "cookie": [
              222,
              173,
              190,
              239
            ]
          }
        }
      ]
    },
    "expect": {
      "packet_count": 8,
      "fields": [
        {
          "packet": 4,
          "field": "pppoe.session_id",
          "value": "0x0001"
        }
      ],
      "frames": [
        {
          "packet": 1,
          "offset": 20,
          "hex": "01 01 00 08"
        },
        {
          "packet": 2,
          "offset": 20,
          "hex": "01 01 00 08"
        },
        {
          "packet": 3,
          "offset": 32,
          "hex": "01 04 00 04 de ad be ef"
        }
      ],
      "notes": [
        "PADI: Service-Name 'internet'(8B)；PADO: +AC-Name 'BRAS-1'(0102 len 6)+AC-Cookie(0104 len 4)；PADR offset 32=20+ServiceName 12 后 echo cookie",
        "现网 BRAS 形：AC-Name 标识局设备、AC-Cookie 关联发现与会话（注记：Host-Uniq 0103=B′）；cookie 用字节数组（字符串=原文字节语义，hex 串会被当 ASCII）"
      ]
    }
  },
