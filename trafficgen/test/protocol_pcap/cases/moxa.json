[
  {
    "id": "moxa_single_up",
    "proto": "moxa",
    "summary": "S1/T-MOXA-S1-01: 单向上行 \"hello\"，8 包 = 3 握手 + 1 数据 + 4 挥手（事件模式无单独 ACK）",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "tcp": {
            "dst_port": 4800
          }
        },
        {
          "moxa": {
            "stream": [
              {
                "payload": "hello"
              }
            ]
          }
        }
      ]
    },
    "expect": {
      "packet_count": 8,
      "has_handshake": true,
      "negotiated": true,
      "terminates": true,
      "has_payload": false,
      "fields": [
        {
          "packet": 4,
          "field": "tcp.dstport",
          "value": "4800"
        },
        {
          "packet": 4,
          "field": "tcp.flags",
          "value": "0x018"
        }
      ],
      "frames": [
        {
          "packet": 4,
          "offset": 54,
          "hex": "68 65 6c 6c 6f"
        }
      ],
      "notes": [
        "S1: 单向上行固定 payload；dst_port 显式 4800"
      ]
    },
    "notes": [
      "S1: 单向上行固定 payload;dst_port 显式 4800;8 包=3握手+1数据+4挥手(事件模式无独立ACK)"
    ]
  },
