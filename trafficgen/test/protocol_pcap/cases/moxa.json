   "layers": [
    {
     "tcp": {}
    },
    {
     "moxa": {}
    }
   ],
   "src_ip": "10.0.0.1",
   "dst_ip": "20.0.0.1",
   "dst_port": 4800,
   "moxa": {
    "stream": [
     {
      "payload": ""
     }
    ]
   }
  },
  "expect": {
   "expect_error": true,
   "error_contains": "moxa: empty stream block or payload required"
  },
  "notes": [
   "N-1/E-T1: 空 payload 校验拒绝"
  ]
 },
 {
