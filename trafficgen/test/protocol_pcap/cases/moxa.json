[
 {
  "id": "moxa_single_up",
  "proto": "moxa",
  "summary": "S1/T-MOXA-S1-01: 单向上行 \"hello\"，8 包 = 3 握手 + 1 数据 + 4 挥手（事件模式无单独 ACK）",
  "spec_json": {
   "layers": [
    {
     "tcp": {}
    },
    {
     "moxa": {}
    }
   ],
   "src_ip": "10.0.0.1",
   "dst_ip": "20.0.0.1",
   "dst_port": 4800,
   "moxa": {
    "stream": [
     {
      "payload": "hello"
     }
    ]
   }
  },
  "expect": {
   "packet_count": 8,
   "has_handshake": true,
   "negotiated": true,
   "terminates": true,
   "has_payload": false,
   "fields": [
    {
     "packet": 4,
     "field": "tcp.dstport",
     "value": "4800"
    },
    {
     "packet": 4,
     "field": "tcp.flags",
     "value": "0x018"
    }
   ],
   "frames": [
    {
     "packet": 4,
     "offset": 54,
     "hex": "68 65 6c 6c 6f"
    }
   ],
   "notes": [
    "S1: 单向上行固定 payload；dst_port 显式 4800"
   ]
  },
  "notes": [
   "S1: 单向上行固定 payload;dst_port 显式 4800;8 包=3握手+1数据+4挥手(事件模式无独立ACK)"
  ]
 },
 {
  "id": "moxa_multi_segment",
  "proto": "moxa",
  "summary": "S2/T-MOXA-S2-01: 单块 2000B A > MSS1460 → 2 段（1460+540），payload 首字节 41，段 1=包4 段 2=包5",
  "spec_json": {
   "layers": [
    {
     "tcp": {
      "mss": 1460
     }
    },
    {
     "moxa": {}
    }
   ],
   "src_ip": "10.0.0.1",
   "dst_ip": "20.0.0.1",
   "dst_port": 4800,
   "moxa": {
    "stream": [
     {
      "payload": ""
     }
    ]
   }
  },
  "expect": {
   "has_handshake": true,
   "has_payload": true,
   "terminates": true,
   "fields": [
    {
     "packet": 4,
     "field": "tcp.dstport",
     "value": "4800"
    }
   ],
   "frames": [
    {
     "packet": 4,
     "offset": 54,
     "hex": "41"
    },
    {
     "packet": 5,
     "offset": 54,
     "hex": "41"
    }
   ],
   "notes": [
    "S2: 2000B 单块 MSS 分段；hex 前缀匹配首字节，不整段穷举"
   ],
   "packet_count": 9
  },
  "notes": [
   "S2: 2000B>MSS1460 分 2 段(1460+540);段1=包4 段2=包5;帧长1514>80 故 has_payload=True"
  ]
 },
 {
  "id": "moxa_bidirectional",
  "proto": "moxa",
  "summary": "S3/T-MOXA-S3-01: 双向 4 块流（up WR/down RT 交替），事件模式每块 1 包，11 包 = 3 握手 + 4 数据 + 4 挥手",
  "spec_json": {
   "layers": [
    {
     "tcp": {
      "mss": 536
     }
    },
    {
     "moxa": {}
    }
   ],
   "src_ip": "10.0.0.1",
   "dst_ip": "20.0.0.1",
   "dst_port": 4800,
   "moxa": {
    "stream": [
     {
      "direction": "up",
      "payload": "WR"
     },
     {
      "direction": "down",
      "payload": "RT"
     },
     {
      "direction": "up",
      "payload": "WR"
     },
     {
      "direction": "down",
      "payload": "RT"
     }
    ]
   }
  },
  "expect": {
   "has_handshake": true,
   "negotiated": true,
   "terminates": true,
   "directional": true,
   "has_payload": false,
   "fields": [
    {
     "packet": 4,
     "field": "tcp.dstport",
     "value": "4800"
    },
    {
     "packet": 5,
     "field": "tcp.srcport",
     "value": "4800"
    },
    {
     "field": "tcp.dstport",
     "distinct_values": [
      "4800"
     ],
     "distinct_exclude": [
      "12345"
     ]
    }
   ],
   "frames": [
    {
     "packet": 4,
     "offset": 54,
     "hex": "57 52"
    },
    {
     "packet": 5,
     "offset": 54,
     "hex": "52 54"
    }
   ],
   "notes": [
    "S3: down 段 srcport=4800（服务器端口对换）；directional 双向",
    "packet5 tcp.srcport=4800 是 down 端口对换唯一守卫（设计 §6.3/R1）",
    "dstport distinct_exclude 滤下行握手/挥手包 dst=客户端源端口 12345"
   ],
   "packet_count": 11
  },
  "notes": [
   "S3: 事件模式 4 数据块各 1 包(WR/RT 交替 up/down);11 包=3+4+4;directional≥2 ip.src;packet5 srcport=4800"
  ]
 },
 {
  "id": "moxa_sessions_multi",
  "proto": "moxa",
  "summary": "S4/T-MOXA-S4-01: 多串口会话 = flows=3，src_port 12345/12346/12347，dst_port 恒 4800，3×8=24 包；聚合用 distinct_exclude 滤掉对端口",
  "spec_json": {
   "layers": [
    {
     "tcp": {}
    },
    {
     "moxa": {}
    }
   ],
   "src_ip": "10.0.0.1",
   "dst_ip": "20.0.0.1",
   "dst_port": 4800,
   "moxa": {
    "stream": [
     {
      "payload": "hello"
     }
    ]
   }
  },
  "strategy_fc": {
   "type": "flows",
   "value": 3
  },
  "expect": {
   "has_handshake": true,
   "has_payload": false,
   "fields": [
    {
     "field": "tcp.srcport",
     "distinct_values": [
      "12345",
      "12346",
      "12347"
     ],
     "distinct_exclude": [
      "4800"
     ]
    },
    {
     "field": "tcp.dstport",
     "distinct_values": [
      "4800"
     ],
     "distinct_exclude": [
      "12345",
      "12346",
      "12347"
     ]
    }
   ],
   "notes": [
    "S4: 3 流 × 8 包 = 24；流交织 → distinct_values 聚合断言"
   ],
   "terminates": true,
   "packet_count": 24
  },
  "notes": [
   "S4: flows=3 策略级多会话;src 12345-47/dst 4800;distinct_exclude 滤对端端口"
  ]
 },
