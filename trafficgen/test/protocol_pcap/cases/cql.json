 {
  "id": "cql_multi_session",
  "proto": "cql",
  "summary": "S9: two independent CQL sessions",
  "spec_json": {
   "layers": [
    {
     "ip": {
      "src": "10.0.0.1",
      "dst": "20.0.0.1"
     }
    },
    {
     "tcp": {
      "src_port": 12345,
      "dst_port": 9042
     }
    },
    {
     "cql": {
      "wire_profile": "cql_v4",
      "sessions": [
       {
        "src_port": 12345,
        "events": [
         {
          "kind": "startup",
          "direction": "c2s",
          "options": {
           "CQL_VERSION": "3.0.0"
          }
         },
         {
          "kind": "ready",
          "direction": "s2c"
         }
        ]
       },
       {
        "src_port": 12346,
        "events": [
         {
          "kind": "startup",
          "direction": "c2s",
          "options": {
           "CQL_VERSION": "3.0.0"
          }
         },
         {
          "kind": "ready",
          "direction": "s2c"
         }
        ]
       }
      ]
     }
    }
   ]
  },
  "expect": {
   "packet_count": 18,
   "has_handshake": true,
   "terminates": true,
   "has_payload": true,
   "directional": true,
   "fields": [
    {
     "packet": 4,
     "field": "tcp.srcport",
     "distinct_values": [
      "12345",
      "12346"
     ],
     "distinct_exclude": [
      "9042"
     ]
    },
    {
     "packet": 4,
     "field": "tcp.dstport",
     "value": "9042"
    }
   ]
  },
  "notes": [
   "Session state and stream IDs are scoped per TCP four-tuple; no global packet interleaving is assumed."
  ]
 },
