 {
  "id": "cql_prepare_execute",
  "proto": "cql",
  "summary": "S5: PREPARE/EXECUTE requests after STARTUP/READY",
  "spec_json": {
   "layers": [
    {
     "ip": {
      "src": "10.0.0.1",
      "dst": "20.0.0.1"
