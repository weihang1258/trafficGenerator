  {
    "id": "radius_attr_formats",
    "proto": "radius",
    "summary": "T-RADIUS-15 属性四 format+VSA 枚举格（string/ipv4/uint32/hex+VSA vendor_id 9；9.20-9.22 双列表 attributes/response_attributes 各≥1 格）",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "radius": {
            "src_port": 12345,
            "dst_port": 1812,
            "code": 1,
            "attributes": [
              {
                "type": 1,
                "value": "user"
              },
              {
                "type": 8,
                "format": "ipv4",
                "value": "10.0.0.1"
              },
              {
                "type": 5,
                "format": "uint32",
                "value": "42"
              },
              {
                "type": 6,
                "format": "hex",
                "value": "aabb"
              },
              {
                "type": 26,
                "vendor_id": 9,
                "value": "vs"
              }
            ],
            "response_code": 2,
            "response_attributes": [
              {
                "type": 26,
                "vendor_id": 9,
                "value": "ok"
              }
            ]
          }
        }
      ]
    },
    "expect": {
      "packet_count": 2,
      "fields": [
        {
          "packet": 1,
          "field": "radius.avp.type",
          "value": "1,8,5,6,26"
        },
        {
          "packet": 1,
          "field": "radius.avp.length",
          "value": "6,6,6,4,10"
        },
        {
          "packet": 2,
          "field": "radius.avp.type",
          "value": "26"
        }
      ],
      "notes": [
        "format{string,ipv4,uint32,hex}4/4（:406-422）；VSA type 26 外层+vendor_id 9（:432-445）",
        "1=User-Name(string)、8=Framed-IP(ipv4)、5=NAS-Port-Id(uint32)、6=Service-Type(hex 2B)；avp.type 逐序断言",
        "tshark 同包多 AVP 逗号拼接（P5 校准）；length: 1→8(6+2)/8→6/5→7/6→6/26VSA→13(8+5)"
      ]
    }
  },
