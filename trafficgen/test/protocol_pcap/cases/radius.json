[
  {
    "id": "radius_smoke_01",
    "proto": "radius",
    "summary": "冒烟（改写）：[ip,radius] 空业务面→1 轮 req(up)/rsp(down) 2 包。端口显式化 12345/1812（worker/缺省显式化，mpls 轮先例）；code1→2 auto、id 0 复刻、length 26/20、authenticator nonzero 全保留等价",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "radius": {
            "src_port": 12345,
            "dst_port": 1812
          }
        }
      ]
    },
    "expect": {
      "packet_count": 2,
      "fields": [
        {
          "packet": 1,
          "field": "udp.dstport",
          "value": "1812"
        },
        {
          "packet": 1,
          "field": "radius.code",
          "value": "1"
        },
        {
          "packet": 1,
          "field": "radius.id",
          "value": "0"
        },
        {
          "packet": 1,
          "field": "radius.length",
          "value": "26"
        },
        {
          "packet": 1,
          "field": "radius.req",
          "value": "1"
        },
        {
          "packet": 1,
          "field": "radius.avp.type",
          "value": "1"
        },
        {
          "packet": 1,
          "field": "radius.avp.length",
          "value": "6"
        },
        {
          "packet": 2,
          "field": "radius.code",
          "value": "2"
        },
        {
          "packet": 2,
          "field": "radius.id",
          "value": "0"
        },
        {
          "packet": 2,
          "field": "radius.rsp",
          "value": "1"
        },
        {
          "packet": 2,
          "field": "radius.reqframe",
          "value": "1"
        },
        {
          "packet": 2,
          "field": "radius.length",
          "value": "20"
        },
        {
          "packet": 2,
          "field": "radius.authenticator",
          "nonzero": true
        },
        {
          "packet": 1,
          "field": "radius.authenticator",
          "nonzero": true
        }
      ],
      "notes": [
        "RFC 2865 §3：Code/ID/Length/Authenticator 固定头；1=Access-Request、2=Access-Accept",
        "autoResponse（radius.go:42-80）：code 1→2，同 4 元组回包，id 复刻",
        "端口显式 12345/1812（层显式化，mpls 轮先例）；authenticator 请求侧缺省随机/响应侧恒随机，仅 nonzero",
        "length 26 含 User-Name(1) AVP 长 6；响应 length 20 无属性"
      ]
    }
  },
