 {
  "id": "dameng_multi_session",
  "proto": "dameng",
  "summary": "S8: two independent authenticated sessions",
  "spec_json": {
   "layers": [
    {
     "ip": {
      "src": "10.0.0.1",
      "dst": "20.0.0.1"
     }
    },
    {
     "tcp": {
      "src_port": 12345
     }
    },
    {
     "dameng": {
      "wire_profile": "dm8_profile_pending",
      "sessions": [
       {
        "src_port": 12345,
        "events": [
         {
          "kind": "connect",
          "direction": "c2s",
          "profile": "connect_default"
         },
         {
          "kind": "auth_request",
          "direction": "c2s",
          "profile": "auth_default"
         },
         {
          "kind": "auth_response",
          "direction": "s2c",
          "profile": "auth_default",
          "result": "success"
         }
        ]
       },
       {
        "src_port": 12346,
        "events": [
         {
          "kind": "connect",
          "direction": "c2s",
          "profile": "connect_default"
         },
         {
          "kind": "auth_request",
          "direction": "c2s",
          "profile": "auth_default"
         },
         {
          "kind": "auth_response",
          "direction": "s2c",
          "profile": "auth_default",
          "result": "success"
         }
        ]
       }
      ]
     }
    }
   ]
  },
  "expect": {
   "packet_count": 20,
   "has_handshake": true,
   "terminates": true,
   "has_payload": true,
   "fields": [
    {
     "field": "tcp.srcport",
     "distinct_values": [
      "12345",
      "12346"
     ],
     "distinct_exclude": [
      "5236"
     ]
    },
    {
     "field": "tcp.dstport",
     "distinct_values": [
      "5236"
     ],
     "distinct_exclude": [
      "12345",
      "12346"
     ]
    }
   ]
  },
  "notes": []
 },
