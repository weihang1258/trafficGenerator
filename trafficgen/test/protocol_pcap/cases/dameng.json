      "src_port": {
       "strategy": "inc",
       "range": [
        12345,
        12347
       ],
       "step": 1
      }
     }
    },
    {
     "dameng": {
      "wire_profile": "dm8_profile_pending",
      "events": [
       {
        "kind": "connect",
        "direction": "c2s",
        "profile": "connect_default"
       }
      ]
     }
    }
   ]
  },
  "expect": {
   "packet_count": 24,
