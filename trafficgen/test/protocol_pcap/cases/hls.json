            "src_port": 40000,
            "dst_port": 80
          }
        },
        {
          "http": {}
        },
        {
          "hls": {}
        }
      ],
      "hls": {
        "profile": "rfc8216_v7",
        "sessions": [
          {
            "kind": "master",
            "uri": "/live/master.m3u8",
            "variants": [
