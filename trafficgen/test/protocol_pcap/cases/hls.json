  {
    "id": "hls_aes128_key",
    "proto": "hls",
    "summary": "HLS AES-128 key and IV association",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "192.0.2.10",
            "dst": "198.51.100.20"
          }
        },
        {
          "tcp": {
            "src_port": 40005,
            "dst_port": 80
          }
        },
        {
          "http": {}
        },
        {
          "hls": {}
        }
      ],
      "hls": {
        "profile": "rfc8216_v7",
        "sessions": [
          {
            "kind": "media",
            "session_id": "live",
            "uri": "/live/encrypted.m3u8",
            "target_duration": 6,
            "body": "#EXTM3U\n#EXT-X-KEY:METHOD=AES-128,URI=\"/keys/live.key\",IV=0x0000000000000000000000000000002A\n#EXTINF:5.0,\n/seg/1.ts\n#EXT-X-KEY:METHOD=NONE\n",
            "segments": [
              {
                "uri": "/seg/1.ts",
                "duration": 5.0,
                "key_ref": "/keys/live.key"
              }
            ]
          },
          {
            "kind": "key",
            "session_id": "live",
            "uri": "/keys/live.key",
            "key": {
              "method": "AES-128",
              "uri": "/keys/live.key",
              "iv": "0x0000000000000000000000000000002a"
            },
            "response_body_b64": "AQIDBAUGBwgJCAsMDQ4PEA"
          },
          {
            "kind": "segment",
            "session_id": "live",
            "uri": "/seg/1.ts",
            "response_status_code": 200,
            "response_body_b64": "AQIDBAUGBwgJCAsMDQ4PEA",
            "key_ref": "/keys/live.key"
          },
          {
            "kind": "key",
            "session_id": "live",
            "uri": "/keys/none.key",
            "key": {
              "method": "NONE"
            }
          }
        ]
      }
    },
    "expect": {
      "packet_count": 15,
      "fields": [
        {
          "packet": 4,
          "field": "http.request.uri",
          "value": "/live/encrypted.m3u8"
        },
        {
          "packet": 5,
          "field": "http.response.code",
          "value": "200"
        }
      ]
    }
  },
