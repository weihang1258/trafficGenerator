 {
  "id": "jt808_t2_frame_header_bytes",
  "proto": "jt808",
  "summary": "T-2 帧头字节钉：0x7e 定界+msgId/props/手机号 BCD/SN+XOR 校验和（initial_sn=42 显式）",
