  {
    "id": "ldap_composite_multi_round",
    "proto": "ldap",
    "summary": "T-14 复合大场景（9.50）：rounds=2+equality filter+非匿名 bind+自定义属性 ≥3 类交织；16 包",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "ldap": {
            "rounds": 2,
            "filter_type": "equality",
            "search_filter": "sAMAccountName",
            "filter_value": "jdoe",
            "bind_dn": "CN=svc,DC=corp",
            "bind_password": "pw",
            "attributes": [
              "cn",
              "member"
            ],
            "unbind": false
          }
        }
      ]
    },
    "expect": {
      "packet_count": 17,
      "has_handshake": true,
      "terminates": true,
      "fields": [
        {
          "packet": 4,
          "field": "tcp.flags",
          "value": "0x018"
        },
        {
          "packet": 9,
          "field": "tcp.flags",
          "value": "0x018"
        }
      ],
      "notes": [
        "多轮+equality+simple 认证+自定义属性四类交织；AD 现网服务账号查询形"
      ]
    }
  },
