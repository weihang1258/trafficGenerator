      ]
    }
  },
  {
    "id": "rtsp_composite_full_session_media",
    "proto": "rtsp",
    "summary": "T-10 复合大场景（9.50）：五方法全序+emit_media+自定义头+SDP body ≥3 类交织",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "rtsp": {
            "dialog": [
              {
                "method": "OPTIONS",
                "headers": [
                  "User-Agent: trafficgen"
                ]
              },
              {
                "status_code": 200,
                "status_text": "OK"
              },
              {
                "method": "DESCRIBE"
              },
              {
                "status_code": 200,
                "status_text": "OK",
                "body": "v=0\r\n"
              },
              {
                "method": "SETUP"
              },
              {
                "status_code": 200,
                "status_text": "OK"
              },
              {
                "method": "PLAY",
                "emit_media": true
              },
              {
                "status_code": 200,
                "status_text": "OK"
              },
              {
                "method": "TEARDOWN"
              },
              {
                "status_code": 200,
                "status_text": "OK"
              }
            ],
            "media": {
              "direction": "down",
              "packets": 1,
              "payload": "media"
            }
          }
        }
      ]
    },
    "expect": {
      "has_handshake": true,
      "terminates": true,
      "notes": [
        "五方法+RTP 媒体+自定义头+SDP 四类交织（现网 VLC play 形）"
      ]
    }
  },
  {
