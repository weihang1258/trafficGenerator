[
  {
    "id": "rtsp_options_smoke",
    "proto": "rtsp",
    "summary": "T-1 OPTIONS 冒烟（smoke 改写，等价覆盖）：握手3+OPTIONS req/resp+挥手4=9 包；控制通道 554",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "rtsp": {
            "dialog": [
              {
                "method": "OPTIONS"
              },
              {
                "status_code": 200,
                "status_text": "OK"
              }
            ]
          }
        }
      ]
    },
    "expect": {
      "packet_count": 9,
      "has_handshake": true,
      "terminates": true,
      "fields": [
        {
          "packet": 1,
          "field": "tcp.dstport",
          "value": "554"
        },
        {
          "packet": 4,
          "field": "tcp.dstport",
          "value": "554"
        },
        {
          "packet": 8,
          "field": "tcp.flags",
          "value": "0x011"
        }
      ],
      "notes": [
        "554 由 validateSpecBase DstPort switch 缺省（链路径，dns→53 同款）",
        "恒 554 断言面=tcp.dstport（worker srcport 12345 保底）"
      ]
    }
  },
  {
    "id": "rtsp_play_session_full",
    "proto": "rtsp",
    "summary": "T-2 play 会话全序（现网形）：OPTIONS/DESCRIBE/SETUP/PLAY/TEARDOWN 五方法请求响应+Session 头自动补全",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "rtsp": {
            "dialog": [
              {
                "method": "OPTIONS"
              },
              {
                "status_code": 200,
                "status_text": "OK"
              },
              {
                "method": "DESCRIBE"
              },
              {
                "status_code": 200,
                "status_text": "OK",
                "body": "v=0\r\n"
              },
              {
                "method": "SETUP"
              },
              {
                "status_code": 200,
                "status_text": "OK"
              },
              {
                "method": "PLAY"
              },
              {
                "status_code": 200,
                "status_text": "OK"
              },
              {
                "method": "TEARDOWN"
              },
              {
                "status_code": 200,
                "status_text": "OK"
              }
            ]
          }
        }
      ]
    },
    "expect": {
      "packet_count": 17,
      "has_handshake": true,
      "terminates": true,
      "fields": [
        {
          "packet": 4,
          "field": "tcp.dstport",
          "value": "554"
        },
        {
          "packet": 17,
          "field": "tcp.flags",
          "value": "0x010"
        }
      ],
      "notes": [
        "3 握手+10 消息+4 挥手=17；CSeq/Session 头由 legacy completeRTSPHeaders 自动补全"
      ]
    }
  },
  {
    "id": "rtsp_describe_sdp_body",
    "proto": "rtsp",
    "summary": "T-3 DESCRIBE+SDP body：body 字节透传+Content-Length 自动补",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "rtsp": {
            "dialog": [
              {
                "method": "DESCRIBE"
              },
              {
                "status_code": 200,
                "status_text": "OK",
                "body": "v=0\r\no=- 0 0 IN IP4 20.0.0.1\r\n"
              }
            ]
          }
        }
      ]
    },
    "expect": {
      "packet_count": 9,
      "terminates": true,
      "notes": [
        "SDP 面字节 frames 钉（跑后校准）；Content-Length=body 长度自动写入"
      ]
    }
  },
  {
    "id": "rtsp_response_404",
    "proto": "rtsp",
    "summary": "T-4 404 响应面：status_code=404+reason Not Found",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "rtsp": {
            "dialog": [
              {
                "method": "DESCRIBE"
              },
              {
                "status_code": 404
              }
            ]
          }
        }
      ]
    },
    "expect": {
      "packet_count": 9,
      "terminates": true,
      "notes": [
        "status_text 空→rtspReasonPhrase(404)=Not Found 缺省（T-12 语义）"
      ]
    }
  },
  {
    "id": "rtsp_pause_teardown",
    "proto": "rtsp",
    "summary": "T-5 PAUSE/TEARDOWN 面：两方法请求/响应序",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "rtsp": {
            "dialog": [
              {
                "method": "PLAY"
              },
              {
                "status_code": 200,
                "status_text": "OK"
              },
              {
                "method": "PAUSE"
              },
              {
                "status_code": 200,
                "status_text": "OK"
              },
              {
                "method": "TEARDOWN"
              },
              {
                "status_code": 200,
                "status_text": "OK"
              }
            ]
          }
        }
      ]
    },
    "expect": {
      "packet_count": 13,
      "has_handshake": true,
      "terminates": true,
      "notes": [
        "3 握手+6 消息+4 挥手=15"
      ]
    }
  },
  {
    "id": "rtsp_uri_explicit_and_default",
    "proto": "rtsp",
    "summary": "T-6 URI 面：DESCRIBE 显式 uri=rtsp://20.0.0.1/media；OPTIONS 缺省构造 rtmp 同族 rtsp://<dstIP>/media",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "rtsp": {
            "dialog": [
              {
                "method": "OPTIONS"
              },
              {
                "status_code": 200,
                "status_text": "OK"
              },
              {
                "method": "DESCRIBE",
                "uri": "rtsp://20.0.0.1/media"
              },
              {
                "status_code": 200,
                "status_text": "OK"
              }
            ]
          }
        }
      ]
    },
    "expect": {
      "packet_count": 11,
      "terminates": true,
      "notes": [
        "URI 缺省=rtsp://<dstIP>/media（IPv6 括号分支 B′）；显式值字节入请求行"
      ]
    }
  },
  {
    "id": "rtsp_headers_custom",
    "proto": "rtsp",
    "summary": "T-7 头显式覆盖：headers 自定义 User-Agent 与自动补 CSeq 共存",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "rtsp": {
            "dialog": [
              {
                "method": "OPTIONS",
                "headers": [
                  "User-Agent: trafficgen"
                ]
              },
              {
                "status_code": 200,
                "status_text": "OK"
              }
            ]
          }
        }
      ]
    },
    "expect": {
      "packet_count": 9,
      "terminates": true,
      "notes": [
        "CSeq 缺失自动补（completeRTSPHeaders）；显式头原样透传"
      ]
    }
  },
  {
    "id": "rtsp_emit_media_rtp",
    "proto": "rtsp",
    "summary": "T-8 RTP 媒面子流：PLAY 响应 emit_media=true+media 配置→RTP 包序（legacy emitRTSPMedia 复用）",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "rtsp": {
            "dialog": [
              {
                "method": "OPTIONS"
              },
              {
                "status_code": 200,
                "status_text": "OK"
              },
              {
                "method": "DESCRIBE"
              },
              {
                "status_code": 200,
                "status_text": "OK",
                "body": "v=0\r\n"
              },
              {
                "method": "SETUP"
              },
              {
                "status_code": 200,
                "status_text": "OK"
              },
              {
                "method": "PLAY",
                "emit_media": true
              },
              {
                "status_code": 200,
                "status_text": "OK"
              }
            ],
            "media": {
              "direction": "down",
              "packets": 2,
              "payload": "rtp-payload"
            }
          }
        }
      ]
    },
    "expect": {
      "has_handshake": true,
      "terminates": true,
      "notes": [
        "RTP-Info 头+RTP 包序由 legacy emitRTSPMedia 实测形（包数跑后钉）"
      ]
    }
  },
  {
    "id": "rtsp_direction_explicit",
    "proto": "rtsp",
    "summary": "T-9 direction 显式：覆盖方法推断（down 向请求形——server 主动消息合成面）",
    "spec_json": {
      "layers": [
        {
          "ip": {
            "src": "10.0.0.1",
            "dst": "20.0.0.1"
          }
        },
        {
          "rtsp": {
