[
 {
  "id": "dns_smoke_01",
  "proto": "dns",
  "summary": "[chain] 冒烟：DNS单查询（example.com A记录，层链形[ip,udp,dns]，域名进dns层name）。dst 53（IANA），txid默认0x1234、QR=0、RD=1，共1包",
  "spec_json": {
   "layers": [
    {
     "ip": {
      "src": "10.0.0.1",
      "dst": "20.0.0.1"
     }
    },
    {
     "udp": {
      "src_port": 12345,
      "dst_port": 53
     }
    },
    {
     "dns": {
      "name": "example.com",
      "query_type": 1
     }
    }
   ]
  },
  "expect": {
   "packet_count": 1,
   "fields": [
    {
     "packet": 1,
     "field": "udp.dstport",
     "value": "53"
    },
    {
     "packet": 1,
     "field": "dns.id",
     "value": "0x1234"
    },
    {
     "packet": 1,
     "field": "dns.flags",
     "value": "0x0100"
    },
    {
     "packet": 1,
     "field": "dns.flags.response",
     "value": "0"
    },
    {
     "packet": 1,
     "field": "dns.flags.recdesired",
     "value": "1"
    },
    {
     "packet": 1,
     "field": "dns.qry.name",
     "value": "example.com"
    },
    {
     "packet": 1,
     "field": "dns.qry.type",
     "value": "1"
    },
    {
     "packet": 1,
     "field": "dns.qry.class",
     "value": "0x0001"
    }
   ],
   "notes": [
    "RFC 1035 §4.1：DNS header固定字段（ID/QR/RD/QDCOUNT），此处ID默认0x1234确定值",
    "dns层name=example.com/query_type=1（D-DNS-1：顶层dns子映射已迁入层内）；tshark实测回钉",
    "顶层未设端口：dst默认53（strategy_convert）、src保持flow默认12345，不断言",
    "tshark探针实测：flags=0x0100、qry.name=example.com、qry.type=1、qry.class=0x0001、id=0x1234"
   ]
  }
 },
 {
  "id": "dns_neg_flat",
  "proto": "dns",
  "summary": "负例：顶层dns子映射presence判死（T-DNS-2，空map也死）",
