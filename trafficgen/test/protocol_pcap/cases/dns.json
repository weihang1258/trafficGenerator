      "src_port": 12345,
      "dst_port": 53
     }
    },
    {
     "dns": {
      "name": "example.com",
      "query_type": {
       "strategy": "inc",
       "range": [
        1,
        28
       ],
       "step": 27
      }
     }
    }
   ]
  },
  "strategy_fc": {
   "type": "flows",
   "value": 2
  },
