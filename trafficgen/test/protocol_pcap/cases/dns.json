 {
  "id": "dns_aaaa",
  "proto": "dns",
  "summary": "AAAA查询（T-DNS-4）：dns{query_type:28}→qry.type=28",
  "spec_json": {
   "layers": [
    {
     "ip": {
      "src": "10.0.0.1",
      "dst": "20.0.0.1"
     }
    },
