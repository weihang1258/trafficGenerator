 {
  "id": "dns_response",
  "proto": "dns",
  "summary": "响应包（T-DNS-5）：is_response+response_ip→2包，响应txid回显、A=1.2.3.4",
  "spec_json": {
   "layers": [
    {
     "ip": {
      "src": "10.0.0.1",
      "dst": "20.0.0.1"
     }
    },
    {
     "udp": {
      "src_port": 12345,
      "dst_port": 53
     }
    },
    {
     "dns": {
      "name": "example.com",
      "query_type": 1,
      "is_response": true,
      "response_ip": "1.2.3.4"
     }
    }
   ]
  },
  "expect": {
   "min_packets": 2,
   "fields": [
    {
     "packet": 1,
     "field": "dns.flags.response",
     "value": "0"
    },
    {
     "packet": 2,
     "field": "dns.flags.response",
     "value": "1"
    },
    {
     "packet": 2,
     "field": "dns.a",
     "value": "1.2.3.4"
    }
   ],
   "notes": [
    "T-DNS-5【D-DNS-1 §9】：RFC 1035 §4.1.1响应TXID回显MUST；响应字段名落盘校准回钉"
   ]
  }
 },
 {
  "id": "dns_nxdomain_soa",
  "proto": "dns",
  "summary": "NXDOMAIN+权威节（T-DNS-6）：response_code:3+authority SOA→rcode=3",
  "spec_json": {
   "layers": [
    {
     "ip": {
      "src": "10.0.0.1",
      "dst": "20.0.0.1"
     }
    },
    {
     "udp": {
      "src_port": 12345,
      "dst_port": 53
     }
    },
    {
     "dns": {
      "name": "example.com",
      "query_type": 1,
      "is_response": true,
      "response_code": 3,
      "authority": [
       {
        "name": "example.com",
        "type": 6,
        "mname": "ns.example.com",
        "rname": "hostmaster.example.com",
        "serial": 1,
        "refresh": 3600,
        "retry": 600,
        "expire": 86400,
        "minimum": 300
       }
      ]
     }
    }
   ]
  },
  "expect": {
   "min_packets": 2,
   "fields": [
    {
     "packet": 2,
     "field": "dns.flags.rcode",
     "value": "3"
    }
   ],
   "notes": [
    "T-DNS-6【D-DNS-1 §9】：RFC 1035 §6.2.5负缓存；authority字段名落盘校准回钉"
   ]
  }
 },
