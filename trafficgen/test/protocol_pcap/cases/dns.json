     "packet": 0,
     "field": "dns.qry.type",
     "distinct_values": [
      "1",
      "28"
     ]
    }
   ],
   "notes": [
    "T-DNS-9【D-DNS-1 §12】：int面inc；落盘回钉"
   ]
  }
 },
