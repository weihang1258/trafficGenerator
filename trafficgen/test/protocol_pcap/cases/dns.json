 {
  "id": "dns_name_dynamic",
  "proto": "dns",
  "summary": "name动态（T-DNS-8）：list双域名+flows=2→两流域名distinct",
  "spec_json": {
   "layers": [
    {
     "ip": {
      "src": "10.0.0.1",
      "dst": "20.0.0.1"
     }
    },
    {
     "udp": {
      "src_port": 12345,
      "dst_port": 53
     }
    },
    {
     "dns": {
      "name": {
       "strategy": "list",
       "list": [
        "a.com",
        "b.com"
       ]
      },
      "query_type": 1
     }
    }
   ]
  },
  "strategy_fc": {
   "type": "flows",
   "value": 2
  },
  "expect": {
   "min_packets": 2,
   "fields": [
    {
     "packet": 0,
     "field": "dns.qry.name",
     "distinct_values": [
      "a.com",
      "b.com"
     ]
    }
   ],
   "notes": [
    "T-DNS-8【D-DNS-1 §12】：string面list；聚合方向落盘回钉"
   ]
  }
 },
 {
  "id": "dns_qtype_dynamic",
  "proto": "dns",
  "summary": "query_type动态（T-DNS-9）：inc[1,28 step27]+flows=2→1/28 distinct",
  "spec_json": {
   "layers": [
    {
     "ip": {
      "src": "10.0.0.1",
      "dst": "20.0.0.1"
     }
    },
