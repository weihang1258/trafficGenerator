   "min_packets": 2,
   "fields": [
    {
     "packet": 0,
     "field": "dns.qry.name",
     "distinct_values": [
      "a.com",
      "b.com"
     ]
    }
   ],
   "notes": [
    "T-DNS-8【D-DNS-1 §12】：string面list；聚合方向落盘回钉"
   ]
  }
 },
